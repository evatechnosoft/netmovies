{#- Bu araç @keyiflerolsun tarafından | @KekikAkademi için yazılmıştır. -#}

{#- Header Component -#}
<header class="header">
  <div class="container">
    <div class="header-brand">
      <a href="/" class="logo" aria-label="{{ tr('site_name') }}">
        <span class="logo-wordmark" data-i18n="site_name">{{ tr('site_name') }}</span>
        {% if eklenti_adi and kategori_adi %}
          <small class="logo-tagline unquote">{{ eklenti_adi }} / {{ kategori_adi }}</small>
        {% elif eklenti_adi and sorgu %}
          <small class="logo-tagline">{{ eklenti_adi }} / <i class="fas fa-search"></i> "{{ sorgu }}"</small>
        {% elif eklenti_adi %}
          <small class="logo-tagline">{{ eklenti_adi }}</small>
        {% elif plugin is defined and plugin.name %}
          <small class="logo-tagline">{{ plugin.name }}</small>
        {% else %}
          <small class="logo-tagline">reklamsız izle</small>
        {% endif %}
      </a>
    </div>
    <div class="header-search-wrap">
      {% if plugin is defined and plugin.name %}
      <form method="GET" action="/ara/{{ plugin.name }}" class="search-form header-search-form" id="global-search-form">
        <input type="hidden" name="lang" value="{{ lang }}">
        {% if provider_url %}<input type="hidden" name="provider" value="{{ provider_url }}">{% endif %}
        <input type="text" id="global-search-input" name="sorgu" class="search-input" placeholder="{{ tr('search_plugin_placeholder') }}" data-i18n="search_plugin_placeholder" data-i18n-attr="placeholder" autocomplete="off" tabindex="0" required>
        <button type="button" id="voice-search-button" class="voice-search-button" title="Türkçe sesli arama" aria-label="Türkçe sesli arama"><i class="fas fa-microphone"></i></button>
        <button type="submit" id="global-search-button" class="search-button" aria-label="Ara"><i class="fas fa-search"></i></button>
      </form>
      {% else %}
      <div class="search-form header-search-form" id="global-search-form">
        <input type="text" id="global-search-input" class="search-input" placeholder="{{ tr('search_all_placeholder') }}" data-i18n="search_all_placeholder" data-i18n-attr="placeholder" autocomplete="off" tabindex="0">
        <button type="button" id="voice-search-button" class="voice-search-button" title="Türkçe sesli arama" aria-label="Türkçe sesli arama"><i class="fas fa-microphone"></i></button>
        <button type="button" id="global-search-button" class="search-button" aria-label="Ara"><i class="fas fa-search"></i></button>
      </div>
      {% endif %}
      <span id="voice-search-status" class="voice-search-status" aria-live="polite"></span>
    </div>
    <div class="header-actions">
      <button type="button" id="toggle-global-settings" class="global-settings-trigger" aria-expanded="false" aria-controls="global-settings-panel" title="Ayarlar">
        <i class="fas fa-cog"></i><span class="sr-only">Ayarlar</span>
      </button>
    </div>
  </div>
  <aside id="global-settings-panel" class="global-settings-panel is-hidden" aria-label="Global ayarlar">
    <div class="global-settings-heading"><span>GLOBAL AYARLAR</span><button type="button" id="close-global-settings" aria-label="Kapat">×</button></div>
    <div class="global-settings-language">
      <span>Dil</span>
      <div class="lang-switch" role="group" aria-label="{{ tr('language_label') }}">
        <button type="button" class="lang-btn{% if lang == 'tr' %} active{% endif %}" data-lang="tr" aria-pressed="{{ 'true' if lang == 'tr' else 'false' }}">TR</button>
        <button type="button" class="lang-btn{% if lang == 'en' %} active{% endif %}" data-lang="en" aria-pressed="{{ 'true' if lang == 'en' else 'false' }}">EN</button>
      </div>
    </div>
    <div class="global-settings-actions">
      <button type="button" id="install-pwa-button" class="global-settings-item is-hidden" aria-describedby="install-pwa-status"><i class="fas fa-download"></i><span>Uygulama olarak ekle</span></button>
      <button type="button" id="toggle-mouse-mode" class="global-settings-item" aria-pressed="false"><i class="fas fa-mouse-pointer"></i><span>Mouse modu: Kapalı</span></button>
      <small id="install-pwa-status" class="global-settings-status" aria-live="polite"></small>
      <button type="button" id="toggle-provider-settings" class="global-settings-item"><i class="fas fa-server"></i><span>Sağlayıcı</span><i class="fas fa-chevron-down toggle-chevron"></i></button>
      <button type="button" id="toggle-plugin-settings" class="global-settings-item"><i class="fas fa-puzzle-piece"></i><span>Eklentiler</span><i class="fas fa-chevron-down toggle-chevron"></i></button>
      <a href="/#plugins-list" class="global-settings-item"><i class="fas fa-layer-group"></i><span>Tüm kaynaklar</span></a>
      <a href="/admin" class="global-settings-item"><i class="fas fa-sliders-h"></i><span>Yönetim</span></a>
    </div>
  </aside>
</header>


<script>
  (() => {
    const trigger = document.getElementById('toggle-global-settings');
    const panel = document.getElementById('global-settings-panel');
    const close = document.getElementById('close-global-settings');
    const installButton = document.getElementById('install-pwa-button');
    const installStatus = document.getElementById('install-pwa-status');
    const mouseButton = document.getElementById('toggle-mouse-mode');
    let deferredInstallPrompt = null;
    const setOpen = (open) => {
      panel?.classList.toggle('is-hidden', !open);
      trigger?.setAttribute('aria-expanded', String(open));
    };
    trigger?.addEventListener('click', () => setOpen(panel?.classList.contains('is-hidden')));
    close?.addEventListener('click', () => setOpen(false));
    const isStandalone = () => window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
    const setMouseMode = (enabled) => {
      document.body.classList.toggle('mouse-mode', enabled);
      mouseButton?.setAttribute('aria-pressed', String(enabled));
      const label = mouseButton?.querySelector('span');
      if (label) label.textContent = `Mouse modu: ${enabled ? 'Açık' : 'Kapalı'}`;
      localStorage.setItem('netmovies_mouse_mode', enabled ? '1' : '0');
    };
    setMouseMode(localStorage.getItem('netmovies_mouse_mode') === '1');
    mouseButton?.addEventListener('click', () => setMouseMode(!document.body.classList.contains('mouse-mode')));
    // Kullanıcı daha önce elle ayarlamadıysa, İLK gerçek fare/imleç hareketinde
    // mouse modunu otomatik aç → tek tık poster açar. D-pad (ok tuşları) kullanıcısı
    // mousemove tetiklemez, dolayısıyla TV davranışı bozulmaz; kullanıcı menüden
    // kapatırsa ('0') bir daha otomatik açılmaz.
    if (localStorage.getItem('netmovies_mouse_mode') === null) {
      window.addEventListener('mousemove', () => setMouseMode(true), { once: true });
    }
    window.addEventListener('beforeinstallprompt', (event) => {
      event.preventDefault();
      deferredInstallPrompt = event;
      installButton?.classList.remove('is-hidden');
    });
    window.addEventListener('appinstalled', () => {
      deferredInstallPrompt = null;
      installButton?.classList.add('is-hidden');
      if (installStatus) installStatus.textContent = 'Uygulama eklendi.';
    });
    // TV Bro / JioSphere gibi TV tarayıcıları PWA kurulumunu (beforeinstallprompt)
    // desteklemez; ölü/yanıltıcı buton göstermemek için buton yalnızca gerçekten
    // kurulabilir olduğunda görünür (yukarıdaki beforeinstallprompt açar).
    if (isStandalone()) installButton?.classList.add('is-hidden');
    installButton?.addEventListener('click', async () => {
      if (!deferredInstallPrompt) {
        if (installStatus) installStatus.textContent = 'Tarayıcı menüsü → Ana ekrana ekle seçeneğini kullanın.';
        return;
      }
      deferredInstallPrompt.prompt();
      const choice = await deferredInstallPrompt.userChoice;
      if (choice.outcome === 'accepted') installStatus.textContent = 'Kurulum başlatıldı.';
      deferredInstallPrompt = null;
    });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setOpen(false); });
    const searchInput = document.getElementById('global-search-input');
    const searchButton = document.getElementById('global-search-button');
    const goHomeSearch = () => {
      if (!document.getElementById('search-results') && searchInput?.value.trim()) {
        window.location.href = `/?q=${encodeURIComponent(searchInput.value.trim())}`;
      }
    };
    const pluginSearchForm = document.getElementById('global-search-form')?.tagName === 'FORM';
    if (!pluginSearchForm) {
      searchInput?.addEventListener('keydown', (event) => { if (event.key === 'Enter') goHomeSearch(); });
      searchButton?.addEventListener('click', goHomeSearch);
    }
  })();
</script>
<script>
  (() => {
    const button = document.getElementById('voice-search-button');
    const input = document.getElementById('global-search-input');
    const status = document.getElementById('voice-search-status');
    if (!button || !input) return;
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SpeechRecognition) { button.title = 'Bu tarayıcı sesli aramayı desteklemiyor'; return; }
    const recognition = new SpeechRecognition();
    recognition.lang = 'tr-TR';
    recognition.interimResults = false;
    recognition.maxAlternatives = 1;
    button.addEventListener('click', () => {
      if (button.classList.contains('is-listening')) { recognition.stop(); return; }
      status.textContent = 'Dinliyorum…';
      button.classList.add('is-listening');
      try { recognition.start(); } catch (_) { /* already listening */ }
    });
    recognition.addEventListener('result', (event) => {
      input.value = event.results[0][0].transcript;
      input.dispatchEvent(new Event('input', { bubbles: true }));
      document.getElementById('global-search-button')?.click();
    });
    recognition.addEventListener('error', () => { status.textContent = 'Mikrofon kullanılamadı'; });
    recognition.addEventListener('end', () => { button.classList.remove('is-listening'); setTimeout(() => { status.textContent = ''; }, 1400); });
  })();
</script>
