{% extends "_html_taban.html.j2" %}


{% block breadcrumbs %}{% endblock %}


{% block icerik %}

<div class="detail-container">
    <div class="player-header player-panel-shell">
        <h1 class="player-title"><i class="fas fa-play-circle"></i> {{ baslik }}</h1>
        <div class="player-header-actions">
            <button class="button-icon" id="share-player-btn" title="{{ tr('share') }}" data-i18n="share" data-i18n-attr="title">
                <i class="fas fa-share-alt"></i>
            </button>
        </div>
    </div>

    <div class="source-selection player-panel-shell">
        <h3><i class="fas fa-server"></i> <span data-i18n="sources_title">{{ tr('sources_title') }}</span></h3>
        <div id="video-links-ui" class="source-list"></div>
    </div>

    <!-- Harici oynatıcı (Nova / MX / VLC / Mibox) — tarayıcıda donmaya karşı en akıcı yol -->
    <div class="external-player-bar player-panel-shell is-hidden" id="external-player-bar">
        <h3><i class="fas fa-up-right-from-square"></i> Harici Oynatıcıda Aç</h3>
        <p class="external-player-hint">Aktif kaynağı cihazındaki oynatıcıya gönderir (header'lar proxy üzerinden taşınır).</p>
        <div class="external-player-buttons">
            <button type="button" class="button button-secondary" data-player="nova"><i class="fas fa-play"></i> Nova</button>
            <button type="button" class="button button-secondary" data-player="mx"><i class="fas fa-play"></i> MX Player</button>
            <button type="button" class="button button-secondary" data-player="vlc"><i class="fas fa-play"></i> VLC</button>
            <button type="button" class="button button-secondary" data-player="copy"><i class="fas fa-copy"></i> Linki kopyala</button>
        </div>
        <span class="external-player-status" id="external-player-status"></span>
    </div>
    <style>
    .external-player-bar { margin-top: .75rem; }
    .external-player-hint { color: var(--muted, #8b93a1); font-size: .82rem; margin: .25rem 0 .75rem; }
    .external-player-buttons { display: flex; flex-wrap: wrap; gap: .5rem; }
    .external-player-status { display: block; margin-top: .5rem; color: var(--muted, #8b93a1); font-size: .82rem; }
    </style>
    <script type="module" src="{{ url_for('static_home', path='JS/external-player.min.js') }}" defer></script>

    <div id="video-player-container">
        <div id="video-player-wrapper">
            <div id="loading-overlay" class="player-loading is-hidden">
                <div class="player-message">
                    <div class="wp-spinner"></div>
                </div>
            </div>
            <video id="video-player" playsinline webkit-playsinline crossorigin="anonymous">
                <span data-i18n="browser_video_unsupported">{{ tr('browser_video_unsupported') }}</span>
            </video>

            <!-- Firefox Custom Subtitle Overlay -->
            <div id="custom-subtitle-overlay" class="custom-subtitle-overlay"></div>

            <!-- Netflix Style Custom Controls -->
            <div class="video-controls-overlay">
                <!-- Action Animation -->
                <div class="action-animation" id="action-animation">
                    <i class="fas fa-play"></i>
                </div>



                <!-- Bottom Controls -->
                <div class="bottom-controls">
                    <!-- Progress Slider -->
                    <div class="progress-container" id="custom-progress-container">
                        <div class="progress-bar-fill" id="custom-progress-fill">
                            <div class="progress-handle"></div>
                        </div>
                        <!-- Preview Thumbnail -->
                        <div id="preview-thumbnail" class="preview-thumbnail is-hidden">
                            <div class="preview-canvas-wrapper">
                                <canvas id="preview-canvas"></canvas>
                                <div class="preview-loading">
                                    <div class="wp-spinner wp-spinner-sm"></div>
                                </div>
                            </div>
                            <span id="preview-time" class="preview-time">0:00</span>
                        </div>
                    </div>

                    <div class="control-row">
                        <div class="control-group">
                            <button class="ctrl-btn" id="bottom-play-pause" title="{{ tr('tooltip_play_pause') }}" data-i18n="tooltip_play_pause" data-i18n-attr="title">
                                <i class="fas fa-play"></i>
                            </button>
                            <button class="ctrl-btn" id="custom-backward" title="{{ tr('tooltip_rewind') }}" data-i18n="tooltip_rewind" data-i18n-attr="title">
                                <i class="fas fa-undo"></i>
                            </button>
                            <button class="ctrl-btn" id="custom-forward" title="{{ tr('tooltip_forward') }}" data-i18n="tooltip_forward" data-i18n-attr="title">
                                <i class="fas fa-redo"></i>
                            </button>

                            <!-- Volume -->
                            <div class="volume-group">
                                <button class="ctrl-btn" id="custom-mute" title="{{ tr('tooltip_mute') }}" data-i18n="tooltip_mute" data-i18n-attr="title">
                                    <i class="fas fa-volume-up"></i>
                                </button>
                                <input type="range" id="custom-volume-slider" class="volume-slider" min="0" max="1" step="0.01" value="1" aria-label="{{ tr('tooltip_volume') }}">
                            </div>

                            <!-- Time -->
                            <div class="time-display">
                                <span id="current-time">0:00</span> / <span id="duration-time">0:00</span>
                            </div>
                        </div>

                        <div class="control-group">
                            <button class="ctrl-btn is-hidden" id="custom-quality" title="{{ tr('tooltip_quality') }}" data-i18n="tooltip_quality" data-i18n-attr="title">
                                <i class="fas fa-gauge-high"></i> <span class="ctrl-label"></span>
                            </button>
                            <button class="ctrl-btn is-hidden" id="custom-audio" title="{{ tr('tooltip_audio') }}" data-i18n="tooltip_audio" data-i18n-attr="title">
                                <i class="fas fa-headphones-alt"></i>
                            </button>
                            <button class="ctrl-btn is-hidden" id="custom-cc" title="{{ tr('tooltip_subtitle') }}" data-i18n="tooltip_subtitle" data-i18n-attr="title">
                                <i class="fas fa-closed-captioning"></i>
                            </button>
                            <button class="ctrl-btn" id="player-settings-button" type="button" title="Oynatıcı ayarları" aria-label="Oynatıcı ayarları" aria-expanded="false" aria-controls="player-settings-panel">
                                <i class="fas fa-gear"></i>
                            </button>
                            <button class="ctrl-btn" id="custom-pip" title="Picture-in-Picture aç" aria-label="Picture-in-Picture aç">
                                <i class="fas fa-clone"></i>
                            </button>
                            <button class="ctrl-btn" id="custom-fullscreen" title="{{ tr('tooltip_fullscreen') }}" data-i18n="tooltip_fullscreen" data-i18n-attr="title">
                                <i class="fas fa-expand"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div id="player-settings-panel" class="player-settings-panel is-hidden" role="menu" aria-label="Oynatıcı ayarları">
                <button type="button" class="player-setting-item" data-player-setting="audio" role="menuitem">
                    <i class="fas fa-headphones-alt"></i><span>Dil</span>
                </button>
                <button type="button" class="player-setting-item" data-player-setting="subtitle" role="menuitem">
                    <i class="fas fa-closed-captioning"></i><span>Altyazı</span>
                </button>
                <button type="button" class="player-setting-item" data-player-setting="subtitle-size" role="menuitem">
                    <i class="fas fa-text-height"></i><span>Altyazı görünümü</span>
                </button>
                <button type="button" class="player-setting-item" data-player-setting="speed" role="menuitem">
                    <i class="fas fa-gauge-high"></i><span>Hız</span><strong id="player-speed-value">1x</strong>
                </button>
                <button type="button" class="player-setting-item" data-player-setting="quality" role="menuitem">
                    <i class="fas fa-signal"></i><span>Kalite</span>
                </button>
            </div>

            <!-- Altyazı Ayarları Paneli -->
            <div id="subtitle-settings-panel" class="subtitle-settings-panel is-hidden">
                <div class="subtitle-settings-header">
                    <h3><i class="fas fa-closed-captioning"></i> <span data-i18n="video_subtitle_settings">{{ tr('video_subtitle_settings') }}</span></h3>
                    <button type="button" class="subtitle-settings-close" id="subtitle-settings-close">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="subtitle-settings-body">
                    <div class="subtitle-setting-row">
                        <span class="subtitle-setting-label" data-i18n="video_subtitle_show">{{ tr('video_subtitle_show') }}</span>
                        <label class="wp-switch">
                            <input type="checkbox" id="subtitle-enabled-toggle" checked>
                            <span class="wp-switch-slider"></span>
                        </label>
                    </div>

                    <div id="subtitle-settings-options">
                        <div class="subtitle-setting-section">
                            <span class="subtitle-setting-section-label" data-i18n="video_subtitle_color">{{ tr('video_subtitle_color') }}</span>
                            <div class="subtitle-color-options" id="subtitle-color-options">
                                <button class="subtitle-color-btn active" data-color="#FFFF00" style="background:#FFFF00" title="Sarı"></button>
                                <button class="subtitle-color-btn" data-color="#FFFFFF" style="background:#FFFFFF" title="Beyaz"></button>
                                <button class="subtitle-color-btn" data-color="#18FFFF" style="background:#18FFFF" title="Cyan"></button>
                                <button class="subtitle-color-btn" data-color="#69F0AE" style="background:#69F0AE" title="Yeşil"></button>
                            </div>
                        </div>

                        <div class="subtitle-setting-section">
                            <span class="subtitle-setting-section-label" data-i18n="video_subtitle_size">{{ tr('video_subtitle_size') }}</span>
                            <div class="subtitle-size-control">
                                <span class="subtitle-size-label" id="subtitle-size-value">18</span>
                                <input type="range" id="subtitle-size-slider" class="subtitle-slider" min="12" max="64" step="2" value="18">
                            </div>
                        </div>

                        <div class="subtitle-setting-row">
                            <span class="subtitle-setting-label" data-i18n="video_subtitle_background">{{ tr('video_subtitle_background') }}</span>
                            <label class="wp-switch">
                                <input type="checkbox" id="subtitle-bg-toggle" checked>
                                <span class="wp-switch-slider"></span>
                            </label>
                        </div>
                    </div>

                    <div class="subtitle-preview">
                        <span id="subtitle-preview-text" data-i18n="video_subtitle_preview">{{ tr('video_subtitle_preview') }}</span>
                    </div>
                </div>
            </div>

            <!-- Seçim Dropdown (Altyazı / Ses) -->
            <div id="selection-modal" class="selection-dropdown is-hidden" role="dialog" aria-modal="true">
                <div class="selection-dropdown-header">
                    <h3 id="modal-title"><i id="modal-icon" class="fas fa-closed-captioning"></i> <span data-i18n="selection_prompt">{{ tr('selection_prompt') }}</span></h3>
                    <button type="button" class="selection-dropdown-close" id="selection-close-btn" aria-label="Kapat">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="selection-dropdown-body" id="selection-list">
                    <!-- Seçenekler buraya dinamik olarak eklenecek -->
                </div>
            </div>
        </div>
    </div>

    <style>
    #video-player-container.tv-pip-window {
        position: fixed;
        right: 18px;
        bottom: 18px;
        z-index: 1500;
        margin: 0;
        border: 2px solid var(--primary-color);
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 18px 50px rgba(0, 0, 0, .55);
    }
    #video-player-container.tv-pip-window #video-player-wrapper { aspect-ratio: 16 / 9; }
    #video-player-container.tv-pip-size-1 { width: min(240px, calc(100vw - 28px)); }
    #video-player-container.tv-pip-size-2 { width: min(360px, calc(100vw - 28px)); }
    #video-player-container.tv-pip-size-3 { width: min(480px, calc(100vw - 28px)); }
    #video-player-container.tv-pip-size-4 { width: min(640px, calc(100vw - 28px)); }
    #video-player-wrapper { position: relative; }
    /* Keep every essential control reachable in the smallest floating player. */
    #video-player-container.tv-pip-window .bottom-controls { padding: 0 6px 5px; }
    #video-player-container.tv-pip-window .control-row,
    #video-player-container.tv-pip-window .control-group { gap: 0; }
    #video-player-container.tv-pip-window .ctrl-btn {
        width: 32px;
        min-width: 32px;
        height: 32px;
        min-height: 32px;
        font-size: .78rem;
    }
    #video-player-container.tv-pip-window .ctrl-label { display: none; }
    #video-player-container.tv-pip-window .volume-slider { display: none; }
    #video-player-container.tv-pip-window .time-display {
        padding: 0 2px;
        margin-left: 0;
        font-size: .58rem;
    }
    #video-player-container.tv-pip-window #custom-backward,
    #video-player-container.tv-pip-window #custom-forward { display: none; }
    #video-player-container.tv-pip-window .progress-container {
        height: 15px;
        margin-bottom: 2px;
    }
    #video-player-container.tv-pip-window .progress-container::before,
    #video-player-container.tv-pip-window .progress-bar-fill { height: 3px; }
    #video-player-container.tv-pip-window .progress-handle { width: 10px; height: 10px; }
    @media (max-width: 300px) {
        #video-player-container.tv-pip-window #custom-mute { display: none; }
        #video-player-container.tv-pip-window .time-display { display: none; }
    }
    .player-settings-panel {
        position: absolute;
        right: 12px;
        bottom: 66px;
        z-index: 20;
        display: grid;
        gap: 4px;
        min-width: 188px;
        padding: 7px;
        border: 1px solid var(--glass-edge);
        border-radius: 12px;
        background: rgba(22, 18, 39, .97);
        box-shadow: var(--shadow-strong);
    }
    .player-setting-item {
        display: flex;
        align-items: center;
        gap: 9px;
        width: 100%;
        padding: 9px 10px;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: var(--text-color);
        font: inherit;
        text-align: left;
        cursor: pointer;
    }
    .player-setting-item:hover, .player-setting-item:focus-visible { background: rgba(139, 92, 246, .18); outline: none; }
    .player-setting-item i { width: 18px; color: var(--primary-light); text-align: center; }
    .player-setting-item strong { margin-left: auto; color: var(--primary-light); font-size: .82rem; }
    .bottom-controls #custom-quality, .bottom-controls #custom-audio, .bottom-controls #custom-cc { display: none !important; }
    </style>

    <div id="next-episode-panel" class="player-panel-shell is-hidden"></div>
    <section id="similar-section" class="similar-section"></section>

    <div class="player-controls-section">
        <div class="control-buttons">
            {% if icerik_url %}
            <a href="/icerik/{{ eklenti_adi }}?url={{ icerik_url }}{{ provider_query_amp }}" class="button button-secondary">
                <i class="fas fa-arrow-left"></i> <span data-i18n="player_back_content">{{ tr('player_back_content') }}</span>
            </a>
            {% endif %}
            <a href="/eklenti/{{ eklenti_adi }}{{ provider_query }}" class="button button-secondary">
                <i class="fas fa-th"></i> <span data-i18n="player_back_plugin">{{ tr('player_back_plugin') }}</span>
            </a>
        </div>
    </div>

    <div id="video-links-data" class="is-hidden"
         data-proxy-url="{{ proxy_url|default('', true) }}"
         data-proxy-fallback-url="{{ proxy_fallback_url|default('', true) }}"
         data-proxy-token="{{ proxy_token|default('', true) }}"
         data-provider-id="{{ media_meta.provider_id|default('', true) }}"
         data-provider-base-url="{{ media_meta.provider_base_url|default('', true) }}"
         data-plugin-name="{{ media_meta.plugin_name|default('', true) }}"
         data-content-id="{{ media_meta.content_id|default('', true) }}"
         data-content-url="{{ media_meta.content_url|default('', true) }}"
         data-content-title="{{ baslik | urlencode }}"
         data-poster-url="{{ media_meta.poster_url|default('', true) }}"
         data-year="{{ media_meta.year|default('', true) }}"
         data-rating="{{ media_meta.rating|default('', true) }}"
         data-season="{{ media_meta.season|default('', true) }}"
         data-episode="{{ media_meta.episode|default('', true) }}">
        {% for link in links %}
            <div class="video-link-item" data-name="{{ link.name }}" data-url="{{ link.url }}" data-referer="{{ link.referer|default('', true) }}" data-user-agent="{{ link.user_agent|default('', true) }}" data-extra-headers='{{ link.extra_headers | default({}, true) | tojson }}'>
                {% for subtitle in link.subtitles %}
                    <div class="subtitle-item" data-name="{{ subtitle.name }}" data-url="{{ subtitle.url }}"></div>
                {% endfor %}
            </div>
        {% endfor %}
    </div>

    </div>
</div>

{% endblock %}

{% block js %}
    <script type="module" src="{{ url_for('static_home', path='JS/central-progress.js') }}" defer></script>
    <script type="module" src="{{ url_for('static_home', path='JS/player.min.js') }}" defer crossorigin="anonymous"></script>
{% endblock %}
