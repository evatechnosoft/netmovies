{% extends "_html_taban.html.j2" %}

{% block breadcrumbs %}
<nav class="breadcrumbs">
    <a href="/" class="breadcrumbs-link"><i class="fas fa-home"></i> Ana Sayfa</a>
    <span class="breadcrumbs-sep">/</span>
    <span class="breadcrumbs-current"><i class="fas fa-broadcast-tower"></i> {{ official_source.title }}</span>
</nav>
{% endblock %}

{% block icerik %}
<div class="detail-container official-player-page">
    <div class="player-header player-panel-shell">
        <h1 class="player-title"><i class="fas {{ official_source.icon }}"></i> {{ official_source.title }}</h1>
    </div>
    <div class="official-player-frame player-panel-shell">
        <iframe
            src="{{ official_source.url }}"
            title="{{ official_source.title }}"
            loading="eager"
            allow="autoplay; fullscreen; picture-in-picture"
            referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>
    <div class="player-controls-section official-player-actions">
        <p>{{ official_source.description }} Yayıncı iframe kullanımını engellerse aşağıdaki resmi sayfayı açabilirsin.</p>
        <a class="button button-primary" href="{{ official_source.url }}" target="_blank" rel="noopener noreferrer">
            <i class="fas fa-external-link-alt"></i> Resmi sayfayı aç
        </a>
        <a class="button button-secondary" href="/">Ana sayfaya dön</a>
    </div>
</div>

{% endblock %}
