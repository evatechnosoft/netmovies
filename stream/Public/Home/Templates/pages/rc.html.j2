{#- NetMovies — telefon kumandası. Bilerek tek dosya ve bağımlılıksız: kumanda
    tünelin ucunda, kötü bir hatta, tek elle açılıyor. CDN yazı tipi / ikon paketi
    beklemek yerine emoji kullanılır; site şablonu miras alınmaz. -#}
<!doctype html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
  <meta name="theme-color" content="#0d0f13">
  <link rel="manifest" href="{{ url_for('static_home', path='manifest.webmanifest') }}">
  <link rel="icon" href="{{ url_for('static_home', path='ico/logo.png') }}">
  <title>{{ title }}</title>
  <style>
    :root { --bg:#0d0f13; --kart:#171b22; --cizgi:#252b35; --metin:#e8ecf3; --soluk:#8b94a5; --vurgu:#e50914; --yesil:#2ecc71; }
    * { box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
    body { margin:0; background:var(--bg); color:var(--metin); font:16px/1.4 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
           min-height:100dvh; display:flex; flex-direction:column; overscroll-behavior:none; user-select:none; }

    header { display:flex; align-items:center; gap:10px; padding:10px 14px; padding-top:max(10px,env(safe-area-inset-top));
             border-bottom:1px solid var(--cizgi); background:var(--kart); position:sticky; top:0; z-index:5; }
    header b { font-size:15px; letter-spacing:.3px; }
    #tv-durum { margin-left:auto; display:flex; align-items:center; gap:6px; font-size:12px; color:var(--soluk); }
    #tv-nokta { width:9px; height:9px; border-radius:50%; background:#555; transition:background .3s; }
    #tv-nokta.acik { background:var(--yesil); box-shadow:0 0 8px var(--yesil); }
    #kur { display:none; background:none; border:1px solid var(--cizgi); color:var(--metin); border-radius:8px; padding:6px 10px; font-size:12px; }

    main { flex:1; overflow-y:auto; padding:14px; padding-bottom:calc(76px + env(safe-area-inset-bottom)); }
    .sekme { display:none; } .sekme.aktif { display:block; }

    /* ---- D-pad: başparmak için büyük hedefler, ortada OK ---- */
    .pad { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; max-width:320px; margin:0 auto 18px; aspect-ratio:1; }
    .pad button { background:var(--kart); border:1px solid var(--cizgi); border-radius:16px; color:var(--metin); font-size:26px; }
    .pad button:active, .dugme:active { background:var(--vurgu); transform:scale(.96); }
    .pad .bos { visibility:hidden; }
    .pad .ok { font-size:15px; font-weight:600; border-radius:50%; }

    .satir { display:flex; gap:10px; justify-content:center; flex-wrap:wrap; margin-bottom:14px; }
    .dugme { background:var(--kart); border:1px solid var(--cizgi); color:var(--metin); border-radius:12px;
             padding:14px 16px; font-size:15px; min-width:64px; transition:transform .08s; }
    .dugme.genis { flex:1; min-width:110px; }
    .baslik { color:var(--soluk); font-size:12px; text-transform:uppercase; letter-spacing:1px; margin:18px 0 8px; }

    /* ---- Arama ---- */
    .arama { display:flex; gap:8px; }
    .arama input, textarea { flex:1; background:var(--kart); border:1px solid var(--cizgi); color:var(--metin);
                             border-radius:12px; padding:14px; font-size:16px; font-family:inherit; user-select:text; }
    #mikrofon.dinliyor { background:var(--vurgu); animation:nabiz 1s infinite; }
    @keyframes nabiz { 50% { opacity:.55; } }
    #durum { color:var(--soluk); font-size:13px; min-height:20px; margin:10px 2px; }

    .sonuclar { display:grid; grid-template-columns:repeat(auto-fill,minmax(100px,1fr)); gap:10px; margin-top:12px; }
    .kart { background:var(--kart); border:1px solid var(--cizgi); border-radius:12px; overflow:hidden; text-align:left; padding:0; color:var(--metin); }
    .kart img { width:100%; aspect-ratio:2/3; object-fit:cover; display:block; background:#0a0c10; }
    .kart span { display:block; padding:7px; font-size:12px; line-height:1.25; }
    .kart:active { border-color:var(--vurgu); }
    /* Yanlış basma koruması: kart tek dokunuşla oynatmaz, basılı tutunca onay çıkar. */
    .kart { position:relative; }
    .kart.secili { border-color:var(--vurgu); }
    .kart .onay { position:absolute; inset:auto 0 0 0; background:var(--vurgu); color:#04070d;
      font-weight:700; font-size:13px; padding:10px 6px; border:0; width:100%; display:flex;
      align-items:center; justify-content:center; gap:6px; }
    .kart .onay .ic { width:16px; height:16px; fill:currentColor; }

    /* ---- Şu an oynayan: ince şerit + süre ---- */
    #oynayan { background:var(--kart); border:1px solid var(--cizgi); border-radius:12px; padding:10px 12px; margin-bottom:14px; }
    #oynayan[hidden] { display:none; }
    #oynayan .ad { font-size:14px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    #oynayan .sure { display:flex; justify-content:space-between; color:var(--soluk); font-size:12px; margin:4px 0 6px; font-variant-numeric:tabular-nums; }
    #oynayan .bar { height:3px; background:var(--cizgi); border-radius:2px; overflow:hidden; }
    #oynayan .bar i { display:block; height:100%; width:0; background:var(--vurgu); transition:width .5s linear; }

    /* ---- Son izlenenler: kart ya da liste ---- */
    .baslik.satirli { display:flex; align-items:center; justify-content:space-between; }
    .baslik.satirli button { background:none; border:1px solid var(--cizgi); color:var(--soluk); border-radius:8px; padding:3px 8px; font-size:11px; text-transform:none; letter-spacing:0; }
    .sonuclar.liste { grid-template-columns:1fr; gap:6px; }
    .sonuclar.liste .kart { display:flex; align-items:center; gap:10px; }
    .sonuclar.liste .kart img { width:44px; aspect-ratio:2/3; flex:none; }
    .sonuclar.liste .kart span { font-size:13px; }
    .sonuclar.liste .kart .onay { inset:0 0 0 auto; width:auto; padding:0 14px; }
    /* Raf: tek sıra, yana kaydırmalı — sığmayan alt satıra düşmez (Dean). */
    .sonuclar.raf { display:flex; overflow-x:auto; gap:8px; padding-bottom:6px; scroll-snap-type:x proximity; scrollbar-width:none; }
    .sonuclar.raf::-webkit-scrollbar { display:none; }
    .sonuclar.raf .kart { flex:0 0 96px; scroll-snap-align:start; }
    .sonuclar.raf .kart span { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .sonuclar.raf.liste { display:grid; overflow:visible; }
    .sonuclar.raf.liste .kart { flex:none; }

    /* ---- Dokunmatik yüzey (mouse mode): D-pad yerine kaydırma alanı, başparmak
       hizasında sabit — sayfa nereye kaydırılırsa kaydırılsın elin altında. ---- */
    #tp { display:none; position:fixed; left:14px; right:14px; bottom:calc(58px + env(safe-area-inset-bottom));
          height:180px; background:var(--kart); border:1px solid var(--vurgu); border-radius:18px; z-index:4;
          touch-action:none; user-select:none; align-items:center; justify-content:center; color:var(--soluk); font-size:12px; }
    body.dokunmatik #tp { display:flex; }
    body.dokunmatik .pad { display:none; }
    body.dokunmatik main { padding-bottom:calc(76px + 196px + env(safe-area-inset-bottom)); }
    /* Ara sekmesinde yüzey sonuçların üstüne binmesin. */
    body.sekme-ara #tp { display:none; }
    body.sekme-ara main { padding-bottom:calc(76px + env(safe-area-inset-bottom)); }
    #tp .ipucu { pointer-events:none; text-align:center; line-height:1.6; }
    #tp .ipucu b { display:block; font-size:22px; color:var(--metin); }
    #tp .geri { position:absolute; right:10px; top:10px; background:none; border:1px solid var(--cizgi); color:var(--metin); border-radius:10px; padding:8px 10px; }
    #tp .geri .ic { width:20px; height:20px; margin:0; }
    #tp.aktif { border-color:var(--yesil); }
    #tp .hassas { position:absolute; left:12px; bottom:8px; right:12px; display:flex; align-items:center; gap:8px; font-size:11px; color:var(--soluk); }
    #tp .hassas input { flex:1; accent-color:var(--vurgu); touch-action:auto; }
    /* Kenar şeridi: parmak burada beklerse yön tekrar eder. */
    #tp::after { content:""; position:absolute; inset:0; border-radius:18px; pointer-events:none;
                 box-shadow:inset 0 0 0 22px rgba(255,255,255,.035); }
    #mod { background:none; border:1px solid var(--cizgi); color:var(--soluk); border-radius:8px; padding:6px 10px; font-size:12px; }

    /* ---- Alt sekme çubuğu ---- */
    nav { position:fixed; bottom:0; left:0; right:0; display:flex; background:var(--kart); border-top:1px solid var(--cizgi);
          padding-bottom:env(safe-area-inset-bottom); z-index:5; }
    nav button { flex:1; background:none; border:0; color:var(--soluk); padding:12px 4px; font-size:11px; }
    nav button.aktif { color:var(--metin); box-shadow:inset 0 2px 0 var(--vurgu); }
    nav button i { display:block; font-style:normal; font-size:19px; margin-bottom:3px; }

    /* ---- İkonlar ---- Emoji telefondan telefona değişiyor, bazılarında sarı kutu
       ya da boş kare çiziliyordu. Çizgi ikonlar her cihazda aynı ve metnin rengini alır. */
    .ic { width:24px; height:24px; display:block; margin:0 auto; fill:none; stroke:currentColor;
          stroke-width:1.9; stroke-linecap:round; stroke-linejoin:round; }
    .ic.dolu { fill:currentColor; stroke:none; }
    .dugme.genis { display:flex; align-items:center; justify-content:center; gap:8px; }
    .dugme.genis .ic { margin:0; }
    nav button .ic { margin-bottom:3px; }
  </style>
</head>
<body>

<!-- İkon seti: tek yerde tanımlanır, butonlar <use> ile çağırır. -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <symbol id="i-geri" viewBox="0 0 24 24"><path d="M9 5 3 12l6 7"/><path d="M3 12h12a5 5 0 0 1 5 5v2"/></symbol>
  <symbol id="i-ev" viewBox="0 0 24 24"><path d="M3 11 12 3l9 8"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/></symbol>
  <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></symbol>
  <symbol id="i-oynat" viewBox="0 0 24 24"><path d="M6 4v16M18 4v16" opacity=".35"/><path d="M9 5l9 7-9 7z" fill="currentColor" stroke="none"/></symbol>
  <symbol id="i-dur" viewBox="0 0 24 24"><rect x="6" y="6" width="12" height="12" rx="2" fill="currentColor" stroke="none"/></symbol>
  <symbol id="i-geri10" viewBox="0 0 24 24"><path d="M4 12a8 8 0 1 0 3-6.2"/><path d="M4 4v5h5"/><text x="12" y="15.5" font-size="8" font-family="inherit" fill="currentColor" stroke="none" text-anchor="middle">10</text></symbol>
  <symbol id="i-ileri30" viewBox="0 0 24 24"><path d="M20 12a8 8 0 1 1-3-6.2"/><path d="M20 4v5h-5"/><text x="12" y="15.5" font-size="8" font-family="inherit" fill="currentColor" stroke="none" text-anchor="middle">30</text></symbol>
  <symbol id="i-ses-az" viewBox="0 0 24 24"><path d="M4 9v6h4l5 4V5L8 9z"/><path d="M17 12h4"/></symbol>
  <symbol id="i-ses-cok" viewBox="0 0 24 24"><path d="M4 9v6h4l5 4V5L8 9z"/><path d="M17 12h4M19 10v4"/></symbol>
  <symbol id="i-ara" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6"/><path d="m20 20-4.5-4.5"/></symbol>
  <symbol id="i-yildiz" viewBox="0 0 24 24"><path d="m12 4 2.4 5 5.6.8-4 3.9 1 5.5-5-2.7-5 2.7 1-5.5-4-3.9 5.6-.8z"/></symbol>
  <symbol id="i-tv" viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M8 3l4 3 4-3"/></symbol>
  <symbol id="i-mikrofon" viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></symbol>
  <symbol id="i-kumanda" viewBox="0 0 24 24"><rect x="7" y="2" width="10" height="20" rx="3"/><path d="M12 6.5v3M10.5 8h3M12 14h.01M12 17.5h.01"/></symbol>
</defs></svg>

<header>
  <b>NetMovies</b>
  <button id="kur" type="button">Ekle</button>
  <span id="tv-durum"><i id="tv-nokta"></i><span id="tv-yazi">aranıyor…</span></span>
</header>

<main>
  <!-- ======================= KUMANDA ======================= -->
  <section id="s-kumanda" class="sekme aktif">
    <!-- TV'de oynayan: ad, geçen / kalan süre, ince ilerleme şeridi. TV birkaç
         saniyede bir /remote/state bildirir; bildirim kesilince şerit kaybolur. -->
    <div id="oynayan" hidden>
      <div class="ad"></div>
      <div class="sure"><span class="gecen">0:00</span><span class="kalan">-0:00</span></div>
      <div class="bar"><i></i></div>
    </div>

    <p class="baslik satirli">Yön <button id="mod" type="button">dokunmatik</button></p>
    <div class="pad">
      <div class="bos"></div>
      <button data-key="UP">▲</button>
      <div class="bos"></div>
      <button data-key="LEFT">◀</button>
      <button class="ok" data-key="CENTER">OK</button>
      <button data-key="RIGHT">▶</button>
      <div class="bos"></div>
      <button data-key="DOWN">▼</button>
      <div class="bos"></div>
    </div>

    <div class="satir">
      <button class="dugme" data-key="BACK" aria-label="Geri"><svg class="ic"><use href="#i-geri"/></svg></button>
      <button class="dugme" data-key="HOME" aria-label="Ana"><svg class="ic"><use href="#i-ev"/></svg></button>
      <button class="dugme" data-key="MENU" aria-label="Menü"><svg class="ic"><use href="#i-menu"/></svg></button>
    </div>

    <p class="baslik">Oynatma</p>
    <div class="satir">
      <button class="dugme" data-seek="-10" aria-label="10 saniye geri"><svg class="ic"><use href="#i-geri10"/></svg></button>
      <button class="dugme genis" data-transport="play_pause" aria-label="Oynat / Duraklat"><svg class="ic"><use href="#i-oynat"/></svg></button>
      <button class="dugme" data-seek="30" aria-label="30 saniye ileri"><svg class="ic"><use href="#i-ileri30"/></svg></button>
    </div>
    <div class="satir">
      <button class="dugme" data-volume="-0.1" aria-label="Ses azalt"><svg class="ic"><use href="#i-ses-az"/></svg></button>
      <button class="dugme" data-transport="stop" aria-label="Durdur"><svg class="ic"><use href="#i-dur"/></svg></button>
      <button class="dugme" data-volume="0.1" aria-label="Ses arttır"><svg class="ic"><use href="#i-ses-cok"/></svg></button>
    </div>

    <p class="baslik">Ekranlar</p>
    <div class="satir">
      <button class="dugme" data-nav="home" aria-label="Ana ekran"><svg class="ic"><use href="#i-ev"/></svg></button>
      <button class="dugme" data-nav="browse" aria-label="Gözat"><svg class="ic"><use href="#i-ara"/></svg></button>
      <button class="dugme" data-nav="following" aria-label="Takip"><svg class="ic"><use href="#i-yildiz"/></svg></button>
      <button class="dugme" data-nav="channels" aria-label="Kanallar"><svg class="ic"><use href="#i-tv"/></svg></button>
    </div>

    <!-- Son izlenenler: basılı tut → TV'de devam et. Kart / liste görünümü telefonda hatırlanır. -->
    <p class="baslik satirli">Son izlenenler <button id="gorunum" type="button">liste</button></p>
    <div class="sonuclar raf" id="son"></div>

    <!-- İzlemek isteyeceklerin: önce "izlenecek" listesi, kalan yer Yeni Çıkanlar'dan. -->
    <p class="baslik">İzlemek isteyeceklerin</p>
    <div class="sonuclar raf" id="oneri"></div>
  </section>

  <!-- Dokunmatik yüzey: kaydır = yön, dokun = OK. Sabit konumlu, alt çubuğun üstünde. -->
  <div id="tp">
    <div class="ipucu"><b>kaydır · dokun</b>kaydır: yön &nbsp;·&nbsp; dokun: OK &nbsp;·&nbsp; kenarda tut: sürer</div>
    <button class="geri" type="button" data-key="BACK" aria-label="Geri"><svg class="ic"><use href="#i-geri"/></svg></button>
    <!-- Hassasiyet: bir yön tuşu için kaç px kayma gerekir (az = hassas). -->
    <label class="hassas"><span>hassasiyet</span><input id="esik" type="range" min="20" max="90" step="2"></label>
  </div>

  <!-- ======================= ARA =======================
       Tek kutu, iki iş: telefonda ara ya da aynı metni TV'nin arama kutusuna
       yolla. Ayrı bir "Yaz" sekmesi vardı; aynı metni iki yere yazdırıyordu. -->
  <section id="s-ara" class="sekme">
    <div class="arama">
      <input id="sorgu" type="search" placeholder="Film veya dizi ara…" autocomplete="off" enterkeyhint="search">
      <button class="dugme" id="mikrofon" title="Sesle ara" aria-label="Sesle ara"><svg class="ic"><use href="#i-mikrofon"/></svg></button>
    </div>
    {% if rc_text_to_tv %}
    <div class="satir" style="margin-top:10px">
      <button class="dugme genis" id="tvye-yaz" title="Kutudaki metni televizyonun arama kutusuna yolla"><svg class="ic"><use href="#i-tv"/></svg><span>TV'ye yaz</span></button>
    </div>
    {% endif %}
    <p id="durum"></p>
    <div class="sonuclar" id="sonuclar"></div>
  </section>
</main>

<nav>
  <button class="aktif" data-sekme="kumanda"><svg class="ic"><use href="#i-kumanda"/></svg>Kumanda</button>
  <button data-sekme="ara"><svg class="ic"><use href="#i-ara"/></svg>Ara</button>
</nav>

<script>
(() => {
  'use strict';
  // Yönetim panelinden gelen ayarlar (admin.json). TV de aynı değerleri
  // /api/v1/client_config ile okur — tek kaynak, tek aç/kapa.
  const AYAR = {
    liste : {{ 'true' if rc_show_recent else 'false' }},
    tvYaz : {{ 'true' if rc_text_to_tv else 'false' }},
  };
  const $ = (id) => document.getElementById(id);
  const durum = $('durum');
  const titre = () => { try { navigator.vibrate?.(12); } catch (_) {} };

  // ---------------------------------------------------------------- komut kanalı
  async function komut(govde) {
    titre();
    try {
      const r = await fetch('/api/v1/remote/command', {
        method  : 'POST',
        headers : { 'Content-Type': 'application/json' },
        body    : JSON.stringify(govde),
      });
      const d = await r.json();
      if (!d?.result?.ok) console.warn('komut reddedildi', d?.result?.error);
      return !!d?.result?.ok;
    } catch (_) { return false; }
  }

  // Basılı tutunca tekrar: menüde uzun listeyi tek tek dürtmek yerine kayarak gez.
  document.querySelectorAll('[data-key]').forEach((btn) => {
    const gonder = () => komut({ type: 'key', key: btn.dataset.key });
    let ilk = null, tekrar = null;
    const dur = () => { clearTimeout(ilk); clearInterval(tekrar); };
    btn.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      gonder();
      ilk = setTimeout(() => { tekrar = setInterval(gonder, 160); }, 420);
    });
    ['pointerup', 'pointerleave', 'pointercancel'].forEach((olay) => btn.addEventListener(olay, dur));
  });

  // ---------------------------------------------------------------- dokunmatik yüzey
  // D-pad ekranın üstünde, başparmak alta yetişiyor: "dokunmatik" modda alt çubuğun
  // üstüne sabit bir yüzey gelir. Her ESIK px kayma bir yön tuşu (sürekli sürükle =
  // tekrar), kısa dokunuş OK. Seçim telefonda hatırlanır.
  const tp = $('tp');
  const DOKUN_PX = 10, DOKUN_MS = 350, KENAR_PX = 22, TEKRAR_MS = 170;
  // Hassasiyet: bir yön için gereken kayma (px). Telefonda hatırlanır.
  let esik = 44;
  try { esik = Number(localStorage.getItem('rc_esik')) || 44; } catch (_) {}
  $('esik').value = esik;
  $('esik').addEventListener('input', (e) => {
    esik = Number(e.target.value) || 44;
    try { localStorage.setItem('rc_esik', String(esik)); } catch (_) {}
  });
  ['pointerdown', 'pointermove', 'pointerup'].forEach((olay) => $('esik').addEventListener(olay, (e) => e.stopPropagation()));

  let tpBas = null, tpSon = null, tpAn = 0, tpKaydi = false;
  // Kenar tekrarı: parmak yüzeyin kenarında beklerken o yön sürer (sürükleme bitmesin).
  let kenarYon = null, kenarSayac = null;
  const kenarDur = () => { clearInterval(kenarSayac); kenarSayac = null; kenarYon = null; };
  const yonGonder = (key) => { tp.classList.add('aktif'); komut({ type: 'key', key }); setTimeout(() => tp.classList.remove('aktif'), 120); };
  const kenardaki = (e) => {
    const r = tp.getBoundingClientRect();
    if (e.clientY - r.top < KENAR_PX) return 'UP';
    if (r.bottom - e.clientY < KENAR_PX) return 'DOWN';
    if (e.clientX - r.left < KENAR_PX) return 'LEFT';
    if (r.right - e.clientX < KENAR_PX) return 'RIGHT';
    return null;
  };
  tp.addEventListener('pointerdown', (e) => {
    if (e.target.closest('.geri, .hassas')) return;
    tp.setPointerCapture(e.pointerId);
    tpBas = tpSon = { x: e.clientX, y: e.clientY }; tpAn = Date.now(); tpKaydi = false;
  });
  tp.addEventListener('pointermove', (e) => {
    if (!tpSon) return;
    const dx = e.clientX - tpSon.x, dy = e.clientY - tpSon.y;
    if (Math.abs(dx) >= esik && Math.abs(dx) >= Math.abs(dy)) { yonGonder(dx > 0 ? 'RIGHT' : 'LEFT'); tpSon = { x: e.clientX, y: e.clientY }; tpKaydi = true; }
    else if (Math.abs(dy) >= esik) { yonGonder(dy > 0 ? 'DOWN' : 'UP'); tpSon = { x: e.clientX, y: e.clientY }; tpKaydi = true; }
    // Kenara dayandıysa tekrarı başlat; kenardan çıktıysa durdur.
    const yon = tpKaydi ? kenardaki(e) : null;
    if (yon !== kenarYon) {
      kenarDur();
      if (yon) { kenarYon = yon; kenarSayac = setInterval(() => yonGonder(yon), TEKRAR_MS); }
    }
  });
  const tpBitir = (e) => {
    kenarDur();
    if (!tpBas) return;
    const kisa = Date.now() - tpAn < DOKUN_MS && Math.hypot(e.clientX - tpBas.x, e.clientY - tpBas.y) < DOKUN_PX;
    if (!tpKaydi && kisa) yonGonder('CENTER');
    tpBas = tpSon = null;
  };
  tp.addEventListener('pointerup', tpBitir);
  tp.addEventListener('pointercancel', () => { kenarDur(); tpBas = tpSon = null; });
  tp.addEventListener('contextmenu', (e) => e.preventDefault());

  const modUygula = (dokunmatik) => {
    document.body.classList.toggle('dokunmatik', dokunmatik);
    $('mod').textContent = dokunmatik ? 'tuşlar' : 'dokunmatik';
  };
  let dokunmatikMod = false;
  try { dokunmatikMod = localStorage.getItem('rc_dokunmatik') === '1'; } catch (_) {}
  modUygula(dokunmatikMod);
  $('mod').addEventListener('click', () => {
    dokunmatikMod = !dokunmatikMod;
    modUygula(dokunmatikMod);
    try { localStorage.setItem('rc_dokunmatik', dokunmatikMod ? '1' : '0'); } catch (_) {}
  });

  document.querySelectorAll('[data-transport]').forEach((b) =>
    b.addEventListener('click', () => komut({ type: 'transport', action: b.dataset.transport, value: 0 })));
  document.querySelectorAll('[data-seek]').forEach((b) =>
    b.addEventListener('click', () => komut({ type: 'transport', action: 'seek', value: Number(b.dataset.seek) })));
  document.querySelectorAll('[data-volume]').forEach((b) =>
    b.addEventListener('click', () => komut({ type: 'transport', action: 'volume', value: Number(b.dataset.volume) })));
  document.querySelectorAll('[data-nav]').forEach((b) =>
    b.addEventListener('click', () => komut({ type: 'nav', screen: b.dataset.nav })));

  // ---------------------------------------------------------------- sekmeler
  document.querySelectorAll('nav button').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('nav button').forEach((x) => x.classList.toggle('aktif', x === b));
    document.querySelectorAll('.sekme').forEach((s) => s.classList.toggle('aktif', s.id === 's-' + b.dataset.sekme));
    document.body.classList.toggle('sekme-ara', b.dataset.sekme === 'ara');
    if (b.dataset.sekme === 'ara') yeniCikanlar();
  }));

  // ---------------------------------------------------------------- TV bağlı mı
  async function durumYokla() {
    try {
      const d = await (await fetch('/api/v1/remote/status')).json();
      const acik = !!d?.result?.tv_online;
      $('tv-nokta').classList.toggle('acik', acik);
      $('tv-yazi').textContent = acik ? 'TV bağlı' : 'TV kapalı';
      oynayanGuncelle(d?.result?.now_playing || null);
    } catch (_) { $('tv-yazi').textContent = 'sunucu yok'; }
  }
  durumYokla();
  setInterval(durumYokla, 6000);

  // ---------------------------------------------------------------- şu an oynayan
  // Sunucu 6 sn'de bir konum verir; aradaki saniyeler telefonda sayılır ki şerit
  // takılmadan aksın. TV duraklattıysa sayaç durur.
  const sureYaz = (sn) => {
    sn = Math.max(0, Math.round(sn));
    const s = Math.floor(sn / 3600), d = Math.floor((sn % 3600) / 60), n = sn % 60;
    return (s ? s + ':' + String(d).padStart(2, '0') : d) + ':' + String(n).padStart(2, '0');
  };
  let oynayan = null, oynayanAn = 0;
  function oynayanGuncelle(o) {
    oynayan = o && o.duration > 0 ? o : null;
    oynayanAn = Date.now();
    oynayanCiz();
  }
  function oynayanCiz() {
    const kutu = $('oynayan');
    if (!oynayan) { kutu.hidden = true; return; }
    const gecen = Math.min(oynayan.duration, oynayan.position + (oynayan.playing ? (Date.now() - oynayanAn) / 1000 : 0));
    kutu.hidden = false;
    kutu.querySelector('.ad').textContent = (oynayan.playing ? '▶ ' : '⏸ ') + (oynayan.title || 'Oynatılıyor');
    kutu.querySelector('.gecen').textContent = sureYaz(gecen);
    kutu.querySelector('.kalan').textContent = '-' + sureYaz(oynayan.duration - gecen);
    kutu.querySelector('.bar i').style.width = (100 * gecen / oynayan.duration).toFixed(2) + '%';
  }
  setInterval(oynayanCiz, 1000);

  // ---------------------------------------------------------------- son izlenenler
  // Devam Et rafının ilk 5'i; basılı tut → TV kaldığı yerden sürdürür.
  const poster = (u, t) => '/proxy/image?url=' + encodeURIComponent(u || '') + '&title=' + encodeURIComponent(t || '');
  async function sonIzlenenler() {
    try {
      const d = await (await fetch('/api/v1/continue_watching')).json();
      const ogeler = (d?.result || []).slice(0, 5).map((r) => ({
        plugin: r.plugin, url: r.content_url, title: r.title, poster: r.poster,
      })).filter((o) => o.url);
      kartlariBas($('son'), ogeler);
    } catch (_) {}
  }

  function kartlariBas(kap, ogeler) {
    kap.innerHTML = '';
    ogeler.forEach((o) => {
      const kart = document.createElement('button');
      kart.className = 'kart';
      kart.innerHTML = '<img loading="lazy" alt=""><span></span>';
      kart.querySelector('img').src = poster(o.poster, o.title);
      kart.querySelector('span').textContent = o.title || o.url;
      onayaBagla(kart, o);
      kap.appendChild(kart);
    });
  }

  // İzlemek isteyeceklerin: "izlenecek" listesi önde, 10'a kadar Yeni Çıkanlar
  // (film/dizi dönüşümlü) ile tamamlanır. Aynı başlık iki kez girmez.
  async function oneriler() {
    const cek = (u, sec) => fetch(u).then((r) => r.json()).then(sec).catch(() => []);
    const [liste, filmler, diziler] = await Promise.all([
      cek('/api/v1/lists/izlenecek', (d) => (d?.result || []).map((r) => ({ plugin: r.plugin, url: r.content_url, title: r.title, poster: r.poster }))),
      cek('/api/v1/aggregate_new?type=movie', (d) => d?.result?.items || []),
      cek('/api/v1/aggregate_new?type=serie', (d) => d?.result?.items || []),
    ]);
    const secilen = [], gorulen = new Set();
    const ekle = (o) => {
      const k = (o.title || o.url || '').toLowerCase();
      if (!o.url || !k || gorulen.has(k) || secilen.length >= 10) return;
      gorulen.add(k); secilen.push(o);
    };
    liste.forEach(ekle);
    for (let i = 0; i < Math.max(filmler.length, diziler.length) && secilen.length < 10; i++) {
      if (filmler[i]) ekle(filmler[i]);
      if (diziler[i]) ekle(diziler[i]);
    }
    kartlariBas($('oneri'), secilen);
  }
  oneriler();
  const gorunumUygula = (liste) => {
    $('son').classList.toggle('liste', liste);
    $('gorunum').textContent = liste ? 'kart' : 'liste';
  };
  let listeGorunum = false;
  try { listeGorunum = localStorage.getItem('rc_son_liste') === '1'; } catch (_) {}
  gorunumUygula(listeGorunum);
  $('gorunum').addEventListener('click', () => {
    listeGorunum = !listeGorunum;
    gorunumUygula(listeGorunum);
    try { localStorage.setItem('rc_son_liste', listeGorunum ? '1' : '0'); } catch (_) {}
  });
  sonIzlenenler();

  // ---------------------------------------------------------------- arama

  async function ara(sorgu) {
    if (!sorgu.trim()) return;
    durum.textContent = '“' + sorgu + '” aranıyor…';
    $('sonuclar').innerHTML = '';
    try {
      const d = await (await fetch('/api/v1/search_all?query=' + encodeURIComponent(sorgu))).json();
      const ogeler = d?.result || [];
      durum.textContent = ogeler.length ? ogeler.length + ' sonuç — dokun, TV\'de başlasın' : 'Sonuç yok';
      $('sonuclar').innerHTML = '';
      ogeler.forEach((o) => {
        const kart = document.createElement('button');
        kart.className = 'kart';
        kart.innerHTML = '<img loading="lazy" alt=""><span></span>';
        kart.querySelector('img').src = poster(o.poster, o.title);
        kart.querySelector('span').textContent = o.title || o.url;
        kart.addEventListener('click', () => tvdeOynat(o));
        $('sonuclar').appendChild(kart);
      });
    } catch (_) { durum.textContent = 'Arama başarısız — sunucuya ulaşılamadı'; }
  }

  function basSonuclar(ogeler) {
    const kap = $('sonuclar');
    kap.innerHTML = '';
    ogeler.forEach((o) => {
      const kart = document.createElement('button');
      kart.className = 'kart';
      kart.innerHTML = '<img loading="lazy" alt=""><span></span>';
      kart.querySelector('img').src = poster(o.poster, o.title);
      kart.querySelector('span').textContent = o.title || o.url;
      onayaBagla(kart, o);
      kap.appendChild(kart);
    });
  }

  // Kartlar cebe girmiş telefonda yanlışlıkla basılıyordu: tek dokunuş artık
  // oynatmıyor, ~550 ms basılı tutunca kartın altında onay butonu çıkıyor ve
  // TV'de oynatma yalnız o butona basınca başlıyor.
  const BASILI_MS = 550;

  function onayaBagla(kart, o) {
    let sayac = null;

    const goster = () => {
      document.querySelectorAll('.kart .onay').forEach((d) => d.remove());
      document.querySelectorAll('.kart.secili').forEach((k) => k.classList.remove('secili'));
      kart.classList.add('secili');
      const onay = document.createElement('button');
      onay.className = 'onay';
      onay.innerHTML = '<svg class="ic"><use href="#i-tv"/></svg>TV\'de oynat';
      onay.addEventListener('click', (e) => { e.stopPropagation(); onay.remove(); kart.classList.remove('secili'); tvdeOynat(o); });
      kart.appendChild(onay);
      titre();
    };

    const basla = (e) => {
      if (e.target.closest('.onay')) return;
      sayac = setTimeout(goster, BASILI_MS);
    };
    const bitir = () => { clearTimeout(sayac); sayac = null; };

    kart.addEventListener('pointerdown', basla);
    kart.addEventListener('pointerup', bitir);
    kart.addEventListener('pointercancel', bitir);
    kart.addEventListener('pointerleave', bitir);
    // Basılı tutunca tarayıcının metin seçimi/bağlam menüsü araya girmesin.
    kart.addEventListener('contextmenu', (e) => e.preventDefault());
    kart.addEventListener('click', (e) => { if (!e.target.closest('.onay')) e.preventDefault(); });
  }

  async function tvdeOynat(o) {
    titre();
    const q = new URLSearchParams({ plugin: o.plugin || '', url: o.url || '', title: o.title || '', poster: o.poster || '' });
    try {
      const d = await (await fetch('/api/v1/remote/play?' + q, { method: 'POST' })).json();
      durum.textContent = d?.result?.ok ? '📺 TV\'ye gönderildi: ' + (o.title || '') : 'Gönderilemedi';
    } catch (_) { durum.textContent = 'Gönderilemedi'; }
  }

  $('sorgu').addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.target.blur(); ara(e.target.value); } });

  // Ara sekmesi boş açılmasın: Yeni Çıkanlar listesi gelir, dokununca TV'de başlar.
  // Aramaya girmeden de bir şey seçilebilsin diye — kumandada klavye zahmetli.
  let listeYuklendi = false;
  async function yeniCikanlar() {
    if (!AYAR.liste || listeYuklendi) return;
    listeYuklendi = true;
    durum.textContent = 'Yeni çıkanlar yükleniyor…';
    try {
      const cek = (tip) => fetch('/api/v1/aggregate_new?type=' + tip)
        .then((r) => r.json()).then((d) => (d?.result?.items || []).slice(0, 24)).catch(() => []);
      const [filmler, diziler] = await Promise.all([cek('movie'), cek('serie')]);
      // Film ve dizi dönüşümlü: tek tür listenin başını kaplamasın.
      const karisik = [];
      for (let i = 0; i < Math.max(filmler.length, diziler.length); i++) {
        if (filmler[i]) karisik.push(filmler[i]);
        if (diziler[i]) karisik.push(diziler[i]);
      }
      if (!karisik.length) { durum.textContent = ''; listeYuklendi = false; return; }
      durum.textContent = 'Yeni çıkanlar — dokun, TV\'de başlasın';
      basSonuclar(karisik);
    } catch (_) {
      durum.textContent = '';
      listeYuklendi = false;
    }
  }

  // ---------------------------------------------------------------- TV'ye yaz
  // Arama kutusundaki metin televizyonun arama kutusuna düşer (submit: TV kendi arar).
  $('tvye-yaz')?.addEventListener('click', async () => {
    const metin = $('sorgu').value.trim();
    if (!metin) { durum.textContent = 'Önce bir şey yaz'; return; }
    const ok = await komut({ type: 'text', text: metin, submit: true });
    durum.textContent = ok ? 'TV\'ye yazıldı: ' + metin : 'Gönderilemedi';
  });

  // ---------------------------------------------------------------- sesli komut
  // Gemini sesi doğrudan NİYETE çevirir: "durdur" tuşa, "inception aç" aramaya gider.
  // Sunucuda anahtar yoksa (503) tarayıcının kendi tanımasına düşeriz — o yalnız
  // metin verir, yani sadece arama yapabilir.
  const mikrofon = $('mikrofon');
  let kayit = null;

  async function wavYap(blob) {
    // Gemini'nin belgelenmiş ses biçimleri arasında webm yok; kaydı 16 kHz mono
    // WAV'a çeviriyoruz. Boyut da düşer, tünelden hızlı gider.
    const ac = new (window.AudioContext || window.webkitAudioContext)();
    const cozulmus = await ac.decodeAudioData(await blob.arrayBuffer());
    ac.close();
    const hedef = new OfflineAudioContext(1, Math.ceil(cozulmus.duration * 16000), 16000);
    const kaynak = hedef.createBufferSource();
    kaynak.buffer = cozulmus; kaynak.connect(hedef.destination); kaynak.start();
    const mono = (await hedef.startRendering()).getChannelData(0);

    const tampon = new ArrayBuffer(44 + mono.length * 2);
    const gorunum = new DataView(tampon);
    const yaz = (konum, metin) => { for (let i = 0; i < metin.length; i++) gorunum.setUint8(konum + i, metin.charCodeAt(i)); };
    yaz(0, 'RIFF'); gorunum.setUint32(4, 36 + mono.length * 2, true); yaz(8, 'WAVEfmt ');
    gorunum.setUint32(16, 16, true); gorunum.setUint16(20, 1, true); gorunum.setUint16(22, 1, true);
    gorunum.setUint32(24, 16000, true); gorunum.setUint32(28, 32000, true);
    gorunum.setUint16(32, 2, true); gorunum.setUint16(34, 16, true);
    yaz(36, 'data'); gorunum.setUint32(40, mono.length * 2, true);
    for (let i = 0; i < mono.length; i++) {
      const s = Math.max(-1, Math.min(1, mono[i]));
      gorunum.setInt16(44 + i * 2, s < 0 ? s * 0x8000 : s * 0x7fff, true);
    }
    return new Blob([tampon], { type: 'audio/wav' });
  }

  const base64 = (blob) => new Promise((coz) => {
    const okuyucu = new FileReader();
    okuyucu.onloadend = () => coz(String(okuyucu.result).split(',')[1]);
    okuyucu.readAsDataURL(blob);
  });

  function tarayiciTanima() {
    const Tanima = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!Tanima) { durum.textContent = 'Bu tarayıcı sesli aramayı desteklemiyor'; return; }
    const t = new Tanima();
    t.lang = 'tr-TR'; t.interimResults = false;
    t.onresult = (e) => { const m = e.results[0][0].transcript; $('sorgu').value = m; ara(m); };
    t.onerror = () => { durum.textContent = 'Mikrofon kullanılamadı'; };
    t.onend = () => mikrofon.classList.remove('dinliyor');
    mikrofon.classList.add('dinliyor');
    durum.textContent = 'Dinliyorum…';
    t.start();
  }

  async function sesGonder(blob) {
    durum.textContent = 'Anlaşılıyor…';
    try {
      const wav = await wavYap(blob);
      const d = await (await fetch('/api/v1/voice', {
        method  : 'POST',
        headers : { 'Content-Type': 'application/json' },
        body    : JSON.stringify({ audio: await base64(wav), mime: 'audio/wav' }),
      })).json();

      const n = d?.result;
      if (!n?.ok) {                       // anahtar yok / Gemini erişilemedi
        durum.textContent = 'Sesli komut kapalı — tarayıcı tanımasına geçiliyor';
        tarayiciTanima();
        return;
      }
      if (n.action === 'search' && n.query) { $('sorgu').value = n.query; ara(n.query); return; }
      durum.textContent = n.reply || (n.sent ? 'TV\'ye gönderildi' : 'Anlaşılmadı');
    } catch (_) { durum.textContent = 'Ses gönderilemedi'; }
  }

  mikrofon.addEventListener('click', async () => {
    if (kayit?.state === 'recording') { kayit.stop(); return; }
    if (!navigator.mediaDevices?.getUserMedia || !window.MediaRecorder) {
      // http:// üzerinden mikrofon kapalıdır (yalnız https / localhost).
      tarayiciTanima();
      return;
    }
    try {
      const akis = await navigator.mediaDevices.getUserMedia({ audio: true });
      const parcalar = [];
      kayit = new MediaRecorder(akis);
      kayit.ondataavailable = (e) => parcalar.push(e.data);
      kayit.onstop = () => {
        akis.getTracks().forEach((t) => t.stop());
        mikrofon.classList.remove('dinliyor');
        sesGonder(new Blob(parcalar, { type: kayit.mimeType || 'audio/webm' }));
      };
      kayit.start();
      mikrofon.classList.add('dinliyor');
      durum.textContent = 'Dinliyorum… (bitince tekrar dokun)';
      setTimeout(() => { if (kayit?.state === 'recording') kayit.stop(); }, 12000);
    } catch (_) {
      durum.textContent = 'Mikrofon izni verilmedi';
      mikrofon.classList.remove('dinliyor');
    }
  });

  // ---------------------------------------------------------------- PWA kurulumu
  let kurulumIstemi = null;
  window.addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); kurulumIstemi = e; $('kur').style.display = 'block'; });
  window.addEventListener('appinstalled', () => { $('kur').style.display = 'none'; });
  $('kur').addEventListener('click', async () => {
    if (!kurulumIstemi) return;
    kurulumIstemi.prompt();
    await kurulumIstemi.userChoice;
    kurulumIstemi = null;
    $('kur').style.display = 'none';
  });
  if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {});
})();
</script>
</body>
</html>
