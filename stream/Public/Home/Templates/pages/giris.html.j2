{#- PIN giriş ekranı. Site şablonundan bağımsız: giriş yapılmadan header/arama
    yüklemek hem gereksiz hem de kapının arkasını sızdırır. -#}
<!doctype html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#0d0f13">
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" href="{{ url_for('static_home', path='ico/logo.png') }}">
  <title>{{ title }}</title>
  <style>
    :root { --bg:#0d0f13; --kart:#171b22; --cizgi:#252b35; --metin:#e8ecf3; --soluk:#8b94a5; --vurgu:#e50914; }
    * { box-sizing:border-box; }
    body { margin:0; min-height:100dvh; display:grid; place-items:center; background:var(--bg); color:var(--metin);
           font:16px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; padding:20px; }
    form { background:var(--kart); border:1px solid var(--cizgi); border-radius:18px; padding:32px 28px;
           width:min(360px,100%); text-align:center; }
    h1 { margin:0 0 6px; font-size:22px; letter-spacing:.5px; }
    p { margin:0 0 22px; color:var(--soluk); font-size:14px; }
    input { width:100%; background:var(--bg); border:1px solid var(--cizgi); color:var(--metin); border-radius:12px;
            padding:16px; font-size:28px; text-align:center; letter-spacing:14px; font-family:inherit; }
    input:focus { outline:none; border-color:var(--vurgu); }
    button { width:100%; margin-top:14px; background:var(--vurgu); color:#fff; border:0; border-radius:12px;
             padding:15px; font-size:16px; font-weight:600; cursor:pointer; }
    .hata { color:#ff6b6b; font-size:13px; min-height:18px; margin-top:12px; }
  </style>
</head>
<body>
  <form method="POST" action="/giris">
    <h1>NetMovies</h1>
    <p>Devam etmek için PIN girin</p>
    <input type="password" name="pin" inputmode="numeric" autocomplete="one-time-code"
           maxlength="12" autofocus required aria-label="PIN">
    <input type="hidden" name="devam" value="{{ devam }}">
    <button type="submit">Gir</button>
    <div class="hata">{{ giris_hatasi }}</div>
  </form>
</body>
</html>
