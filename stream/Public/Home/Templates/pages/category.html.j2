{#- Bu araç @keyiflerolsun tarafından | @KekikAkademi için yazılmıştır. -#}
{% extends "_html_taban.html.j2" %}

{% block breadcrumbs %}{% endblock %}

{% block icerik %}


<div class="grid grid-results">
    {% for item in items %}
    <a href="/icerik/{{ eklenti_adi }}?url={{ item.url }}{{ provider_query_amp }}" class="poster-card card-fade-in tv-focusable" style="animation-delay: {{ loop.index0 * 40 }}ms" aria-label="{{ item.title }}"
       data-tv-item="link" data-plugin="{{ eklenti_adi }}" data-content-url="{{ item.url }}" data-content-title="{{ item.title }}" data-poster="{{ item.poster or '' }}" data-media-type="serie">
        <div class="poster-card-img{% if not item.poster %} has-error{% endif %}">
            {% if item.poster %}<img src="{{ poster(item.poster) }}" alt="{{ item.title }}" data-title="{{ item.title }}" loading="lazy" onerror="if(this.dataset.fb){this.parentElement.classList.add('has-error');this.remove();return;} this.dataset.fb=1; this.src='/tmdb-poster?title=' + encodeURIComponent(this.dataset.title || '');">{% endif %}
        </div>
        <div class="poster-card-overlay"><span class="poster-card-title">{{ item.title }}</span></div>
    </a>
    {% endfor %}
</div>

{% if items %}
<div class="pagination-row">
    {% if sayfa > 1 %}
    <a href="/kategori/{{ eklenti_adi }}?kategori_url={{ kategori_url }}&kategori_adi={{ kategori_adi }}&sayfa={{ sayfa - 1 }}{{ provider_query_amp }}" class="button button-secondary pagination-btn">
        <i class="fas fa-chevron-left"></i> <span data-i18n="prev_page">{{ tr('prev_page') }}</span>
    </a>
    {% endif %}
    <span class="pagination-current" data-i18n="page_label_with_number" data-i18n-vars='{"page": "{{ sayfa }}"}'>{{ tr('page_label_with_number', page=sayfa) }}</span>
    {% if can_paginate and items | length >= 10 %}
    <a href="/kategori/{{ eklenti_adi }}?kategori_url={{ kategori_url }}&kategori_adi={{ kategori_adi }}&sayfa={{ sayfa + 1 }}{{ provider_query_amp }}" class="button button-secondary pagination-btn">
        <span data-i18n="next_page">{{ tr('next_page') }}</span> <i class="fas fa-chevron-right"></i>
    </a>
    {% endif %}
</div>
{% else %}
<div class="empty-state-full"><i class="fas fa-folder-open"></i><p data-i18n="category_empty">{{ tr('category_empty') }}</p></div>
{% endif %}
{% endblock %}
