{% extends "_html_taban.html.j2" %}
{% block breadcrumbs %}{% endblock %}

{% block icerik %}

<div id="home-settings-drawer" class="home-settings-drawer is-hidden">
{# Provider Settings Panel (Collapsible) #}
<section id="provider-settings-panel" class="settings-panel is-hidden">
    <div class="settings-panel-shell">
        <div class="settings-panel-head">
            <div class="settings-panel-copy">
                <span class="settings-panel-kicker" data-i18n="provider_kicker">{{ tr('provider_kicker') }}</span>
                <h2 class="settings-panel-title" data-i18n="provider_settings">{{ tr('provider_settings') }}</h2>
                <p class="settings-panel-subtitle" data-i18n="provider_help_text">{{ tr('provider_help_text') }}</p>
            </div>

            {% if is_remote %}
            <div class="status-badge status-badge-success provider-status-card">
                <i class="fas fa-link"></i>
                <div class="status-badge-copy">
                    <strong>{{ provider_name }}</strong>
                    <small class="status-url">{{ provider_url }}</small>
                </div>
            </div>
            {% else %}
            <div class="status-badge status-badge-info provider-status-card">
                <i class="fas fa-home"></i>
                <div class="status-badge-copy">
                    <strong data-i18n="local_provider">{{ tr('local_provider') }}</strong>
                    <small class="status-url" data-i18n="local_provider_meta">{{ tr('local_provider_meta') }}</small>
                </div>
            </div>
            {% endif %}
        </div>

        <div class="settings-panel-body">
            <div class="provider-input-group">
                <div class="provider-input-wrapper">
                    <i class="fas fa-server"></i>
                    <input type="url" id="provider-url-input" class="search-input"
                        placeholder="{{ tr('provider_url_placeholder') }}"
                        data-i18n="provider_url_placeholder" data-i18n-attr="placeholder"
                        value="{{ provider_url or '' }}">
                </div>
                <button type="button" id="set-provider-button" class="button button-primary">
                    <i class="fas fa-check"></i> <span data-i18n="apply">{{ tr('apply') }}</span>
                </button>
                {% if is_remote %}
                <button type="button" id="reset-provider-button" class="button button-secondary">
                    <i class="fas fa-undo"></i> <span data-i18n="reset">{{ tr('reset') }}</span>
                </button>
                {% endif %}
            </div>

            <div class="provider-support-row">
                <div class="provider-help-card">
                    <i class="fab fa-github"></i>
                    <div class="provider-help-copy">
                        <strong data-i18n="example_provider_info">{{ tr('example_provider_info') }}</strong>
                        <a href="https://github.com/WatchBuddy-tv/ExampleProvider" target="_blank" rel="noopener noreferrer" class="provider-help-link">
                            <span data-i18n="learn_more">{{ tr('learn_more') }}</span>
                            <i class="fas fa-external-link-alt provider-help-link-icon"></i>
                        </a>
                    </div>
                </div>
                {% if not is_remote %}
                <button type="button" id="try-example-button" class="button button-secondary button-small">
                    <i class="fas fa-magic"></i> <span data-i18n="try_example">{{ tr('try_example') }}</span>
                </button>
                {% endif %}
            </div>
        </div>
    </div>
</section>
{# Plugin Management Panel (Collapsible) #}
<section id="plugin-settings-panel" class="settings-panel is-hidden">
    <div class="settings-panel-shell">
        <div class="settings-panel-head">
            <div class="settings-panel-copy">
                <span class="settings-panel-kicker" data-i18n="plugin_management">{{ tr('plugin_management') }}</span>
                <h2 class="settings-panel-title" data-i18n="all_plugins">{{ tr('all_plugins') }}</h2>
                <p class="settings-panel-subtitle" data-i18n="plugin_management_subtitle">{{ tr('plugin_management_subtitle') }}</p>
            </div>
        </div>
        <div id="plugin-preferences-list" class="plugin-preferences-list"></div>
    </div>
</section>
</div>

{% if continue_watching %}
<details class="continue-watching-tile" open>
    <summary><i class="fas fa-history"></i> İzlemeye devam et <span class="section-count">{{ continue_watching | length }}</span></summary>
    <div class="continue-watching-row">
        {% for item in continue_watching %}
        <a class="continue-watching-item tv-focusable" href="/icerik/{{ item.plugin }}?url={{ item.content_url | default('', true) | urlencode }}{{ provider_query_amp }}" aria-label="{{ item.title }}">
            <div class="continue-watching-poster">
                {% if item.poster %}<img src="{{ item.poster }}" alt="" loading="lazy">{% else %}<i class="fas fa-film"></i>{% endif %}
                {% if item.duration_seconds and item.duration_seconds > 0 %}<span class="continue-watching-progress" style="--progress:{{ ((item.position_seconds / item.duration_seconds) * 100) | round(0) }}%"></span>{% endif %}
            </div>
            <span class="continue-watching-title">{{ item.title }}{% if item.episode %}<small>{{ item.episode }}</small>{% endif %}</span>
        </a>
        {% endfor %}
    </div>
</details>
{% endif %}

{# Search Results (hidden, filled by search.js) #}
<section id="search-results" class="search-results is-hidden">
    <div class="search-results-head">
        <h2><i class="fas fa-search"></i> <span data-i18n="search_results_title">{{ tr('search_results_title') }}</span>: <span id="search-query-display"></span></h2>
        <button id="clear-search" class="button button-secondary button-small">
            <i class="fas fa-times"></i> <span data-i18n="search_clear">{{ tr('search_clear') }}</span>
        </button>
    </div>
    <div id="plugin-filters" class="plugin-filters is-hidden">
        <div class="filters-header">
            <h3><i class="fas fa-filter"></i> <span data-i18n="plugins_filter_title">{{ tr('plugins_filter_title') }}</span></h3>
            <button id="clear-filters" class="button button-small button-secondary">
                <i class="fas fa-times"></i> <span data-i18n="filters_clear">{{ tr('filters_clear') }}</span>
            </button>
        </div>
        <div id="filters-container" class="filters-container"></div>
    </div>
    <div id="search-status" class="search-status"></div>
    <div id="results-grid" class="grid"></div>
</section>

{# Birleşik "Yeni Çıkanlar" — kaynak-bağımsız yatay raflar (carousel CSS'i yeniden kullanır) #}
{% macro yeni_rafi(baslik, ikon, items, media_type) %}
{% if items %}
<section class="carousel-row yeni-rafi">
    <div class="carousel-header">
        <h2 class="carousel-title"><i class="fas {{ ikon }}"></i> {{ baslik }} <span class="section-count">{{ items | length }}</span></h2>
        <a class="button button-secondary button-small" href="/api/v1/aggregate_new?type={{ media_type }}">Tümünü gör</a>
    </div>
    <div class="carousel-wrapper">
        <div class="carousel-track poster-rail" tabindex="0">
            {% for item in items[:20] %}
            {% set item_meta = (item.category or '') | lower %}
            <a href="/icerik/{{ item.plugin }}?url={{ item.url }}{{ provider_query_amp }}"
               class="poster-card tv-focusable"
               aria-label="{{ item.title }}"
               data-tv-item="true"
               data-media-type="{{ media_type }}"
               data-plugin="{{ item.plugin }}"
               data-content-url="{{ item.url }}"
               data-content-title="{{ item.title }}"
               data-poster="{{ item.poster or '' }}">
                <div class="poster-card-img{% if not item.poster %} has-error{% endif %}">
                    {% if item.poster %}<img src="{{ item.poster }}" alt="{{ item.title }}" loading="lazy" onerror="this.parentElement.classList.add('has-error');this.remove()">{% endif %}
                </div>
                <div class="poster-card-overlay">
                    <span class="poster-card-title">{{ item.title }}</span>
                    <span class="poster-card-meta">
                        {% if 'dublaj' in item_meta %}Dublaj{% endif %}
                        {% if 'türkçe' in item_meta or 'turkce' in item_meta %}TR Altyazı{% endif %}
                        {% if 'ingilizce' in item_meta or 'english' in item_meta or ' eng' in item_meta %}EN Altyazı{% endif %}
                    </span>
                </div>
            </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}
{% endmacro %}

{{ yeni_rafi('Yeni Filmler', 'fa-film', yeni_filmler, 'movie') }}
{{ yeni_rafi('Yeni Diziler', 'fa-tv', yeni_diziler, 'serie') }}

{# Resmi yayıncı sayfaları: doğrudan yayın manifesti/proxy yerine kaynak sahibine yönlendirir. #}
{% if official_sources %}
<section id="official-sources" class="official-sources">
    <div class="section-heading">
        <h2 class="section-title"><i class="fas fa-broadcast-tower"></i> Resmi Kaynaklar</h2>
        <p class="section-subtitle">Canlı TV, dizi ve film yayıncılarının resmi sayfaları</p>
    </div>
    <div class="grid grid-plugins official-source-grid">
        {% for source in official_sources %}
        <a class="card plugin-card official-source-card"
           href="/resmi-kaynak?url={{ source.url | urlencode }}"
           aria-label="{{ source.title }} — {{ source.broadcaster }}">
            <div class="card-icon official-source-icon"><i class="fas {{ source.icon }}"></i></div>
            <div class="card-body">
                <h3 class="card-title">{{ source.title }}</h3>
                <span class="badge badge-lang">{{ source.category }}</span>
            </div>
            <p class="card-desc">{{ source.description }}</p>
            <span class="official-source-link">{{ source.broadcaster }} <i class="fas fa-external-link-alt"></i></span>
        </a>
        {% endfor %}
    </div>
</section>
{% endif %}

{# Plugin List #}
{% if featured %}
<section id="featured-list">
    <div class="section-heading">
        <h2 class="section-title"><i class="fas fa-thumbtack"></i> Öne Çıkanlar <span class="section-count">{{ featured | length }}</span></h2>
    </div>
    <div class="grid grid-plugins">
        {% for f in featured %}
        <a href="/icerik/{{ f.provider }}?url={{ f.url | urlencode }}{{ provider_query_amp }}" class="card plugin-card">
            <div class="card-icon">
                {% if f.poster %}<img src="{{ f.poster }}" alt="{{ f.title }}" loading="lazy">{% else %}<i class="fas fa-star"></i>{% endif %}
            </div>
            <div class="card-body">
                <h3 class="card-title">{{ f.title }}</h3>
                {% if f.rating %}<span class="badge">★ {{ f.rating }}</span>{% endif %}
            </div>
            {% if f.provider %}<p class="card-desc">{{ f.provider }}</p>{% endif %}
        </a>
        {% endfor %}
    </div>
</section>
{% endif %}

<section id="plugins-list">
    <div class="section-heading">
        <h2 class="section-title"><i class="fas fa-plug"></i> <span data-i18n="all_plugins">{{ tr('all_plugins') }}</span> <span class="section-count">{{ plugins | length }}</span></h2>
    </div>
    <div class="grid grid-plugins">
        {% if quick_channels %}
        <details class="channels-dropdown">
            <summary><i class="fas fa-broadcast-tower"></i> Kanallar <span class="section-count">{{ quick_channels | length }}</span></summary>
            <ul class="channels-list">
        {% for channel in quick_channels %}
            <li>
                <a class="channels-list-item tv-focusable" href="/izle/{{ channel.plugin }}?url={{ channel.url | urlencode }}&baslik={{ channel.title | urlencode }}" aria-label="{{ channel.title }}">
                    <i class="fas fa-broadcast-tower"></i>
                    <span class="channels-list-title">{{ channel.title }}</span>
                </a>
            </li>
        {% endfor %}
            </ul>
        </details>
        {% endif %}
        {% for plugin in plugins %}
        <a href="/eklenti/{{ plugin.name }}{{ provider_query }}" class="card plugin-card plugin-poster-card" data-plugin-name="{{ plugin.name }}" style="--card-index:{{ loop.index0 }}">
            <div class="plugin-poster">
                {% if plugin.favicon %}
                <img src="{{ plugin.favicon }}" alt="{{ plugin.name }}" loading="lazy" onerror="this.style.display='none';this.nextElementSibling&&(this.nextElementSibling.style.display='');var i=document.createElement('i');i.className='fas fa-film';this.parentElement.appendChild(i);this.remove()">
                {% else %}
                <i class="fas fa-film"></i>
                {% endif %}
            </div>
            <div class="card-body plugin-poster-body">
                <h3 class="card-title">{{ plugin.name }}</h3>
                <span class="badge badge-lang badge-lang-{{ plugin.language | lower }}">{{ plugin.language | upper }}</span>
            </div>
            <p class="card-desc">{{ plugin.description }}</p>
        </a>
        {% endfor %}
    </div>
</section>

{% endblock %}

{% block js %}
<script id="plugins-data" type="application/json">{{ plugins | tojson }}</script>
<script type="module" src="{{ url_for('static_home', path='JS/global-search.min.js') }}" defer></script>
<script type="module" src="{{ url_for('static_home', path='JS/components/settings-drawer.js') }}" defer></script>
<style>
  .carousel-wrapper { min-width: 0; max-width: 100%; overflow: hidden; }
  .carousel-track { width: 100%; max-width: 100%; min-width: 0; gap: 8px; overflow: hidden; }
  .poster-rail { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); grid-template-rows: repeat(2, auto); gap: 8px; }
  .carousel-track .poster-card { width: 92px; }
  .carousel-row { content-visibility: auto; contain-intrinsic-size: 0 190px; }
  .carousel-track .poster-card:hover { transform: none; box-shadow: none; }
  .carousel-track .poster-card:active { transform: translateY(1px) scale(.985); }
  .carousel-track .poster-card:hover .poster-card-img img { transform: none; }
  .carousel-track .poster-card.tv-focusable { position: relative; }
  .carousel-track .poster-card.tv-focusable:focus-visible { outline: 3px solid var(--primary-light); outline-offset: 4px; }
  .quick-channel-card { width: 112px; flex: 0 0 112px; }
  /* Kanallar: hafif metin listesi (poster yok → lag yok), grid'i tam kaplar */
  .channels-dropdown { grid-column: 1 / -1; }
  .channels-dropdown > summary { cursor: pointer; padding: 10px 12px; border-radius: 12px; background: var(--surface-variant); font-weight: 600; list-style: none; display: flex; align-items: center; gap: 8px; }
  .channels-dropdown > summary::-webkit-details-marker { display: none; }
  .channels-list { list-style: none; margin: 8px 0 0; padding: 4px; max-height: 340px; overflow-y: auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 4px; content-visibility: auto; }
  .channels-list-item { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 8px; color: var(--text-color); text-decoration: none; font-size: .85rem; background: var(--card-bg-color); }
  .channels-list-item i { color: var(--primary-light); flex: 0 0 auto; font-size: .8rem; }
  .channels-list-item:hover { background: var(--primary-soft); }
  .channels-list-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .plugin-poster-card { min-height: 260px; }
  #plugins-list .grid-plugins { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
  #plugins-list .plugin-card { min-height: 0; backdrop-filter: none; -webkit-backdrop-filter: none; box-shadow: var(--shadow-sm); transition: border-color .15s ease, background-color .15s ease; }
  #plugins-list .plugin-card:hover { transform: none; box-shadow: var(--shadow-sm); }
  .plugin-poster { aspect-ratio: 2 / 3; display: grid; place-items: center; padding: 10px; background: var(--surface-variant); }
  .plugin-poster img { width: 70%; height: 70%; object-fit: contain; border-radius: 12px; }
  .plugin-poster i { font-size: 2.5rem; color: var(--primary-light); }
  .plugin-poster-body { padding: 8px 10px 0; }
  .plugin-poster-card .card-desc { padding: 4px 10px 8px; font-size: .72rem; }
  .home-settings-drawer, #provider-settings-panel, #plugin-settings-panel { backdrop-filter: none; -webkit-backdrop-filter: none; }
  .home-settings-drawer { width: min(100%, 900px); margin: 0 auto; }
  .official-sources { margin-top: 2rem; }
  .official-source-grid { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  .official-source-card { position: relative; }
  .official-source-icon { color: var(--primary-light); }
  .official-source-link { display: block; margin-top: .65rem; color: var(--primary-light); font-size: .78rem; font-weight: 700; }
  .official-source-link i { margin-left: .25rem; font-size: .7rem; }
  .tv-episode-picker { position: fixed; inset: 0; z-index: 1000; display: grid; place-items: center; }
  .tv-episode-backdrop { position: absolute; inset: 0; background: rgba(8, 6, 20, .92); backdrop-filter: none; }
  .tv-episode-panel { position: relative; width: min(640px, calc(100vw - 48px)); max-height: 78vh; overflow: auto; padding: 28px; border: 1px solid var(--glass-edge); border-radius: var(--border-radius-xl); background: var(--glass-panel); box-shadow: var(--shadow-strong); }
  .tv-episode-panel h2 { margin: 4px 0 20px; color: var(--text-color); }
  .tv-episode-kicker { color: var(--primary-light); font-size: var(--font-size-xs); font-weight: 800; letter-spacing: .14em; }
  .tv-episode-close { position: absolute; top: 12px; right: 14px; border: 0; background: transparent; color: var(--text-muted); font-size: 28px; cursor: pointer; }
  .tv-episode-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
  .tv-episode-item { display: flex; align-items: center; gap: 12px; padding: 13px 15px; border: 1px solid var(--glass-edge); border-radius: var(--border-radius); color: var(--text-color); text-decoration: none; background: rgba(255,255,255,.03); }
  .tv-episode-item:hover, .tv-episode-item:focus-visible { border-color: var(--primary-color); background: rgba(139,92,246,.13); outline: none; }
  .tv-episode-number { color: var(--primary-light); font-weight: 800; min-width: 28px; }
  .tv-joystick { position: absolute; left: 50%; top: 50%; z-index: 8; width: 92px; height: 92px; transform: translate(-50%, -50%); pointer-events: auto; }
  .tv-joystick-plus, .tv-joystick-action { position: absolute; display: grid; place-items: center; width: 28px; height: 28px; padding: 0; border: 1px solid rgba(255,255,255,.35); border-radius: 50%; color: var(--text-color); background: rgba(20,16,35,.94); box-shadow: 0 4px 14px rgba(0,0,0,.4); cursor: pointer; }
  .tv-joystick-plus { left: 32px; top: 32px; z-index: 2; font-size: 20px; line-height: 1; color: #fff; background: linear-gradient(135deg, var(--primary-color), #a855f7); }
  .tv-joystick-actions { position: absolute; inset: 0; }
  .tv-joystick-action i { color: var(--primary-light); font-size: 11px; }
  .tv-joystick-action:hover, .tv-joystick-action:focus-visible, .tv-joystick-action.is-selected { border-color: var(--primary-light); background: rgba(139,92,246,.9); outline: none; }
  .tv-joystick-action.is-selected i { color: #fff; }
  .tv-joystick-up { left: 32px; top: 0; }
  .tv-joystick-left { left: 0; top: 32px; }
  .tv-joystick-right { right: 0; top: 32px; }
  .tv-joystick-down { left: 32px; bottom: 0; }
  .tv-joystick-lists { position: absolute; top: 96px; left: 50%; display: none; gap: 3px; transform: translateX(-50%); }
  .tv-joystick.is-lists-open .tv-joystick-lists { display: flex; }
  .tv-joystick-list-button { position: static; width: 24px; height: 24px; font-size: 9px; }
  .tv-joystick-list-button i { color: var(--primary-light); }
  .tv-joystick-status { position: absolute; top: 124px; left: 50%; width: max-content; max-width: 160px; transform: translateX(-50%); color: var(--primary-light); font-size: 10px; text-align: center; pointer-events: none; }
  .poster-card-meta { display: block; min-height: 1.1em; color: var(--primary-light); font-size: 9px; font-weight: 700; }
  .continue-watching-tile { margin: 0 0 18px; border: 1px solid var(--glass-edge); border-radius: 12px; background: var(--surface-glass); }
  .continue-watching-tile summary { padding: 10px 12px; color: var(--text-color); cursor: pointer; font-weight: 700; list-style: none; }
  .continue-watching-tile summary::-webkit-details-marker { display: none; }
  .continue-watching-tile summary i { margin-right: 8px; color: var(--primary-light); }
  .continue-watching-row { display: flex; gap: 10px; overflow-x: auto; padding: 0 12px 12px; scrollbar-width: thin; }
  .continue-watching-item { display: flex; align-items: center; gap: 8px; min-width: 190px; padding: 5px; color: var(--text-color); text-decoration: none; border-radius: 8px; }
  .continue-watching-item:active { transform: translateY(1px); }
  .continue-watching-poster { position: relative; width: 38px; height: 54px; flex: 0 0 auto; overflow: hidden; border-radius: 5px; background: var(--surface-variant); display: grid; place-items: center; }
  .continue-watching-poster img { width: 100%; height: 100%; object-fit: cover; }
  .continue-watching-progress { position: absolute; bottom: 0; left: 0; width: var(--progress); height: 3px; background: var(--primary-light); }
  .continue-watching-title { overflow: hidden; font-size: .8rem; text-overflow: ellipsis; white-space: nowrap; }
  .continue-watching-title small { display: block; color: var(--text-muted); font-size: .7rem; }
  .channel-card .channel-poster { aspect-ratio: 2 / 3; }
  .channels-dropdown { grid-column: 1 / -1; border: 1px solid var(--glass-edge); border-radius: 10px; background: var(--surface-glass); }
  .channels-dropdown summary { padding: 10px 12px; cursor: pointer; color: var(--text-color); font-weight: 700; list-style: none; }
  .channels-dropdown summary::-webkit-details-marker { display: none; }
  .channels-dropdown summary i { margin-right: 8px; color: var(--primary-light); }
  .channels-dropdown-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; padding: 0 10px 10px; }
  .channels-dropdown .channel-card { min-height: 0; }
  @media (max-width: 900px) { .poster-rail { grid-template-columns: repeat(8, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .poster-rail { grid-template-columns: repeat(5, minmax(0, 1fr)); } .carousel-track .poster-card { width: 100%; } }
</style>
{% endblock %}
