{#- Bu araç @keyiflerolsun tarafından | @KekikAkademi için yazılmıştır. -#}
{% extends "_html_taban.html.j2" %}
{% block breadcrumbs %}{% endblock %}

{% block icerik %}

<div id="home-settings-drawer" class="home-settings-drawer is-hidden">
{# Provider Settings Panel (Collapsible) #}
<section id="provider-settings-panel" class="settings-panel is-hidden">
    <div class="settings-panel-shell">
        <div class="settings-panel-head">
            <div class="settings-panel-copy">
                <span class="settings-panel-kicker" data-i18n="provider_kicker">{{ tr('provider_kicker') }}</span>
                <h2 class="settings-panel-title" data-i18n="provider_settings">{{ tr('provider_settings') }}</h2>
                <p class="settings-panel-subtitle" data-i18n="provider_help_text">{{ tr('provider_help_text') }}</p>
            </div>

            {% if is_remote %}
            <div class="status-badge status-badge-success provider-status-card">
                <i class="fas fa-link"></i>
                <div class="status-badge-copy">
                    <strong>{{ provider_name }}</strong>
                    <small class="status-url">{{ provider_url }}</small>
                </div>
            </div>
            {% else %}
            <div class="status-badge status-badge-info provider-status-card">
                <i class="fas fa-home"></i>
                <div class="status-badge-copy">
                    <strong data-i18n="local_provider">{{ tr('local_provider') }}</strong>
                    <small class="status-url" data-i18n="local_provider_meta">{{ tr('local_provider_meta') }}</small>
                </div>
            </div>
            {% endif %}
        </div>

        <div class="settings-panel-body">
            <div class="provider-input-group">
                <div class="provider-input-wrapper">
                    <i class="fas fa-server"></i>
                    <input type="url" id="provider-url-input" class="search-input"
                        placeholder="{{ tr('provider_url_placeholder') }}"
                        data-i18n="provider_url_placeholder" data-i18n-attr="placeholder"
                        value="{{ provider_url or '' }}">
                </div>
                <button type="button" id="set-provider-button" class="button button-primary">
                    <i class="fas fa-check"></i> <span data-i18n="apply">{{ tr('apply') }}</span>
                </button>
                {% if is_remote %}
                <button type="button" id="reset-provider-button" class="button button-secondary">
                    <i class="fas fa-undo"></i> <span data-i18n="reset">{{ tr('reset') }}</span>
                </button>
                {% endif %}
            </div>

            <div class="provider-support-row">
                <div class="provider-help-card">
                    <i class="fab fa-github"></i>
                    <div class="provider-help-copy">
                        <strong data-i18n="example_provider_info">{{ tr('example_provider_info') }}</strong>
                        <a href="https://github.com/WatchBuddy-tv/ExampleProvider" target="_blank" rel="noopener noreferrer" class="provider-help-link">
                            <span data-i18n="learn_more">{{ tr('learn_more') }}</span>
                            <i class="fas fa-external-link-alt provider-help-link-icon"></i>
                        </a>
                    </div>
                </div>
                {% if not is_remote %}
                <button type="button" id="try-example-button" class="button button-secondary button-small">
                    <i class="fas fa-magic"></i> <span data-i18n="try_example">{{ tr('try_example') }}</span>
                </button>
                {% endif %}
            </div>
        </div>
    </div>
</section>
{# Plugin Management Panel (Collapsible) #}
<section id="plugin-settings-panel" class="settings-panel is-hidden">
    <div class="settings-panel-shell">
        <div class="settings-panel-head">
            <div class="settings-panel-copy">
                <span class="settings-panel-kicker" data-i18n="plugin_management">{{ tr('plugin_management') }}</span>
                <h2 class="settings-panel-title" data-i18n="all_plugins">{{ tr('all_plugins') }}</h2>
                <p class="settings-panel-subtitle" data-i18n="plugin_management_subtitle">{{ tr('plugin_management_subtitle') }}</p>
            </div>
        </div>
        <div id="plugin-preferences-list" class="plugin-preferences-list"></div>
    </div>
</section>
</div>

{# Search Results (hidden, filled by search.js) #}
<section id="search-results" class="search-results is-hidden">
    <div class="search-results-head">
        <h2><i class="fas fa-search"></i> <span data-i18n="search_results_title">{{ tr('search_results_title') }}</span>: <span id="search-query-display"></span></h2>
        <button id="clear-search" class="button button-secondary button-small">
            <i class="fas fa-times"></i> <span data-i18n="search_clear">{{ tr('search_clear') }}</span>
        </button>
    </div>
    <div id="plugin-filters" class="plugin-filters is-hidden">
        <div class="filters-header">
            <h3><i class="fas fa-filter"></i> <span data-i18n="plugins_filter_title">{{ tr('plugins_filter_title') }}</span></h3>
            <button id="clear-filters" class="button button-small button-secondary">
                <i class="fas fa-times"></i> <span data-i18n="filters_clear">{{ tr('filters_clear') }}</span>
            </button>
        </div>
        <div id="filters-container" class="filters-container"></div>
    </div>
    <div id="search-status" class="search-status"></div>
    <div id="results-grid" class="grid grid-results"></div>
</section>

{# Üst bant — tek satır, boydan boya ince pill butonlar (cloudstream tarzı).
   Kategoriler doğrudan sayfaya gider; kullanıcı listeleri / kaynaklar / kanallar
   butona basınca PANEL açar (aşağı inmeye gerek yok). #}
<nav id="quick-nav" class="quick-nav" aria-label="Hızlı erişim">
    {% for cat in home_categories %}
    <a class="qn-btn tv-focusable"
       href="/kategori/{{ cat.plugin }}?kategori_url={{ cat.kategori_url }}&kategori_adi={{ cat.kategori_adi | urlencode }}{{ provider_query_amp }}"
       aria-label="{{ cat.title }}">
        <i class="fas {{ cat.icon }}"></i><span>{{ cat.title }}</span>
    </a>
    {% endfor %}
    <span class="qn-sep" aria-hidden="true"></span>
    <button type="button" class="qn-btn tv-focusable" data-panel="devam"><i class="fas fa-history"></i><span>Devam</span></button>
    <button type="button" class="qn-btn tv-focusable" data-panel="favori"><i class="fas fa-heart"></i><span>Favori</span></button>
    <button type="button" class="qn-btn tv-focusable" data-panel="izlenecek"><i class="fas fa-bookmark"></i><span>İzlenecek</span></button>
    <span class="qn-sep" aria-hidden="true"></span>
    <button type="button" class="qn-btn tv-focusable" data-panel="kaynaklar"><i class="fas fa-plug"></i><span>Kaynaklar</span></button>
    <button type="button" class="qn-btn tv-focusable" data-panel="kanallar"><i class="fas fa-broadcast-tower"></i><span>Kanallar</span></button>
</nav>

{# Panel gövdeleri — varsayılan gizli, üstteki buton toggle eder. #}
<div id="qn-panels" class="qn-panels">
    <section class="qn-panel is-hidden" data-panel-body="devam">
        <div class="qn-panel-head"><h2><i class="fas fa-history"></i> İzlemeye Devam Et</h2></div>
        {% if continue_watching %}
        <div class="continue-watching-row">
            {% for item in continue_watching %}
            <a class="continue-watching-item tv-focusable" href="/icerik/{{ item.plugin }}?url={{ item.content_url | default('', true) | urlencode }}{{ provider_query_amp }}" aria-label="{{ item.title }}">
                <div class="continue-watching-poster">
                    {% if item.poster or item.title %}<img src="{{ poster(item.poster, item.title) }}" alt="" loading="lazy" onerror="this.replaceWith(Object.assign(document.createElement('i'), {className: 'fas fa-film'}));">{% else %}<i class="fas fa-film"></i>{% endif %}
                    {% if item.duration_seconds and item.duration_seconds > 0 %}<span class="continue-watching-progress" style="--progress:{{ ((item.position_seconds / item.duration_seconds) * 100) | round(0) }}%"></span>{% endif %}
                </div>
                <span class="continue-watching-title">{{ item.title }}{% if item.episode %}<small>{{ item.episode }}</small>{% endif %}</span>
            </a>
            {% endfor %}
        </div>
        {% else %}<p class="qn-empty">Henüz izlemeye başladığın bir şey yok.</p>{% endif %}
    </section>
    <section class="qn-panel is-hidden" data-panel-body="favori">
        <div class="qn-panel-head"><h2><i class="fas fa-heart"></i> Favorilerim</h2></div>
        <div class="qn-lazy" data-endpoint="/api/v1/favorites"><p class="qn-empty">Yükleniyor…</p></div>
    </section>
    <section class="qn-panel is-hidden" data-panel-body="izlenecek">
        <div class="qn-panel-head"><h2><i class="fas fa-bookmark"></i> İzlenecekler</h2></div>
        <div class="qn-lazy" data-endpoint="/api/v1/lists/izlenecek"><p class="qn-empty">Yükleniyor…</p></div>
    </section>
    <section class="qn-panel is-hidden" data-panel-body="kaynaklar">
        <div class="qn-panel-head"><h2><i class="fas fa-plug"></i> Kaynaklar <span class="section-count">{{ plugins | length }}</span></h2></div>
        <div class="grid grid-plugins qn-plugin-grid">
            {% for plugin in plugins %}
            <a href="/eklenti/{{ plugin.name }}{{ provider_query }}" class="card plugin-card plugin-poster-card" data-plugin-name="{{ plugin.name }}" style="--card-index:{{ loop.index0 }}">
                <div class="plugin-poster">
                    {% if plugin.favicon %}<img src="{{ plugin.favicon }}" alt="{{ plugin.name }}" loading="lazy" onerror="this.style.display='none'">{% else %}<i class="fas fa-film"></i>{% endif %}
                </div>
                <div class="card-body plugin-poster-body">
                    <h3 class="card-title">{{ plugin.name }}</h3>
                    <span class="badge badge-lang badge-lang-{{ plugin.language | lower }}">{{ plugin.language | upper }}</span>
                </div>
            </a>
            {% endfor %}
        </div>
    </section>
    <section class="qn-panel is-hidden" data-panel-body="kanallar">
        <div class="qn-panel-head"><h2><i class="fas fa-broadcast-tower"></i> Kanallar <span class="section-count">{{ quick_channels | length }}</span></h2></div>
        {% if quick_channels %}
        <ul class="channels-list">
            {% for channel in quick_channels %}
            <li>
                <a class="channels-list-item tv-focusable" href="/izle/{{ channel.plugin }}?url={{ channel.url | urlencode }}&baslik={{ channel.title | urlencode }}" aria-label="{{ channel.title }}">
                    <i class="fas fa-broadcast-tower"></i><span class="channels-list-title">{{ channel.title }}</span>
                </a>
            </li>
            {% endfor %}
        </ul>
        {% else %}<p class="qn-empty">Kanal kaynağı tanımlı değil (M3U_SOURCES / RECTV_URL).</p>{% endif %}
    </section>
</div>

{# Birleşik "Yeni Çıkanlar" — kaynak-bağımsız yatay raflar (carousel CSS'i yeniden kullanır) #}
{% macro yeni_rafi(baslik, ikon, items, media_type) %}
{% if items %}
<section class="carousel-row yeni-rafi">
    <div class="carousel-header">
        <h2 class="carousel-title"><i class="fas {{ ikon }}"></i> {{ baslik }} <span class="section-count">{{ items | length }}</span></h2>
    </div>
    <div class="carousel-wrapper">
        <div class="carousel-track poster-rail" tabindex="0">
            {% for item in items[:20] %}
            {% set item_meta = (item.category or '') | lower %}
            <a href="/icerik/{{ item.plugin }}?url={{ item.url }}{{ provider_query_amp }}"
               class="poster-card tv-focusable"
               aria-label="{{ item.title }}"
               data-tv-item="true"
               data-media-type="{{ media_type }}"
               data-plugin="{{ item.plugin }}"
               data-content-url="{{ item.url }}"
               data-content-title="{{ item.title }}"
               data-poster="{{ item.poster or '' }}">
                <div class="poster-card-img{% if not item.poster %} has-error{% endif %}">
                    {% if item.poster or item.title %}<img src="{{ poster(item.poster, item.title) }}" alt="{{ item.title }}" loading="lazy" onerror="this.parentElement.classList.add('has-error'); this.remove();">{% endif %}
                </div>
                <div class="poster-card-overlay">
                    <span class="poster-card-title">{{ item.title }}</span>
                    <span class="poster-card-meta">
                        {% if 'dublaj' in item_meta %}Dublaj{% endif %}
                        {% if 'türkçe' in item_meta or 'turkce' in item_meta %}TR Altyazı{% endif %}
                        {% if 'ingilizce' in item_meta or 'english' in item_meta or ' eng' in item_meta %}EN Altyazı{% endif %}
                    </span>
                </div>
            </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}
{% endmacro %}

{{ yeni_rafi('Yeni Filmler', 'fa-film', yeni_filmler, 'movie') }}
{{ yeni_rafi('Yeni Türk Diziler', 'fa-tv', yeni_turk_diziler, 'serie_local') }}
{{ yeni_rafi('Yeni Yabancı Diziler', 'fa-globe', yeni_yabanci_diziler, 'serie_foreign') }}

{% endblock %}

{% block js %}
<script id="plugins-data" type="application/json">{{ plugins | tojson }}</script>
<script type="module" src="{{ url_for('static_home', path='JS/global-search.min.js') }}" defer></script>
<script type="module" src="{{ url_for('static_home', path='JS/components/settings-drawer.js') }}" defer></script>

<script>
// Üst bant panel toggle (accordion) + kullanıcı listelerini lazy fetch.
(function () {
  var nav = document.getElementById('quick-nav');
  var panels = document.getElementById('qn-panels');
  if (!nav || !panels) return;
  var allPanels = panels.querySelectorAll('.qn-panel');

  nav.addEventListener('click', function (e) {
    var btn = e.target.closest('.qn-btn[data-panel]');
    if (!btn) return;
    var key = btn.getAttribute('data-panel');
    var panel = panels.querySelector('.qn-panel[data-panel-body="' + key + '"]');
    if (!panel) return;
    var willOpen = panel.classList.contains('is-hidden');
    allPanels.forEach(function (p) { p.classList.add('is-hidden'); });
    nav.querySelectorAll('.qn-btn').forEach(function (b) { b.classList.remove('is-active'); });
    if (willOpen) {
      panel.classList.remove('is-hidden');
      btn.classList.add('is-active');
      var lazy = panel.querySelector('.qn-lazy[data-endpoint]:not(.loaded)');
      if (lazy) loadLazy(lazy);
    }
  });

  function loadLazy(box) {
    box.classList.add('loaded');
    fetch(box.getAttribute('data-endpoint'), { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
      .then(function (d) {
        var items = (d && d.result) || [];
        if (!items.length) { box.innerHTML = '<p class="qn-empty">Liste boş.</p>'; return; }
        box.className = 'qn-lazy grid grid-plugins qn-plugin-grid loaded';
        box.innerHTML = items.map(function (it) {
          var url = encodeURIComponent(it.content_url || it.url || '');
          var titleSafe = encodeURIComponent(it.title || '');
          // Zincir (kaynak → proxy cache → TMDB) sunucuda; burada tek URL yeter.
          var poster = (it.poster || it.title)
            ? '<img src="/proxy/image?url=' + encodeURIComponent(it.poster || '') + '&title=' + titleSafe + '" alt="" loading="lazy" onerror="this.style.display=\'none\'">'
            : '<i class="fas fa-film"></i>';
          return '<a class="card plugin-card plugin-poster-card" href="/icerik/'
            + encodeURIComponent(it.plugin || '') + '?url=' + url + '">'
            + '<div class="plugin-poster">' + poster + '</div>'
            + '<div class="card-body plugin-poster-body"><h3 class="card-title">'
            + (it.title || '') + '</h3></div></a>';
        }).join('');
      })
      .catch(function () { box.innerHTML = '<p class="qn-empty">Yüklenemedi.</p>'; });
  }
})();
</script>
{% endblock %}
