{#- NetMovies — /tv: televizyon arayüzü (LG webOS / eski TV tarayıcıları).

   Site şablonunu MİRAS ALMAZ ve ana web arayüzünün JS'ini KULLANMAZ: LG'nin
   tarayıcısı Chrome 68 (2018), ana arayüzdeki `?.` sözdizimi orada SyntaxError
   verip script bloğunun tamamını öldürüyor. Burası bilerek ES2017 ile yazılmış,
   tek dosya, bağımlılıksız.

   Fare yok, dokunma yok: her şey D-pad ile. Odak tarayıcının odak sistemine
   bırakılmaz (odak grupları TV'de tuşu yutuyor) — konum JS'te tutulur.
-#}
<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=1920">
<title>NetMovies TV</title>
<style>
  :root {
    --bg: #0d0f13; --kart: #1a1d24; --yazi: #e8ecf3; --sonuk: #8b94a5;
    --vurgu: #7c5cff; --kart-g: 226px; --kart-y: 339px; --bosluk: 24px;
    /* client-tv NmDim ile aynı ızgara: 7 poster, 2:3, kenar 48dp, aralık 12dp (1080p'de ×2) */
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden;
    background: var(--bg); color: var(--yazi);
    font-family: "LG Smart UI", "Helvetica Neue", Arial, sans-serif;
  }
  .gizli { display: none !important; }

  #ust {
    position: absolute; top: 0; left: 0; right: 0; height: 84px;
    padding: 0 96px; line-height: 84px; z-index: 5;
    background: linear-gradient(to bottom, rgba(13,15,19,.98), rgba(13,15,19,0));
  }
  .marka { font-size: 30px; font-weight: 700; letter-spacing: .5px; }
  .marka em { color: var(--vurgu); font-style: normal; }
  #ipucu { float: right; font-size: 21px; color: var(--sonuk); }

  #raflar { position: absolute; top: 84px; left: 0; right: 0; bottom: 0; overflow: hidden; }
  #kaydir { transition: transform .22s ease-out; }
  .raf { padding: 0 0 12px 96px; opacity: .55; transition: opacity .2s; }
  .raf-ad { font-size: 26px; font-weight: 600; margin: 8px 0 10px; color: var(--sonuk); }
  .raf.etkin { opacity: 1; }
  .raf.etkin .raf-ad { color: var(--yazi); }
  .serit { white-space: nowrap; transition: transform .22s ease-out; }

  .kart {
    display: inline-block; vertical-align: top;
    width: var(--kart-g); margin-right: var(--bosluk);
    transition: transform .18s ease-out;
  }
  .poster {
    position: relative; width: 100%; height: var(--kart-y);
    background: var(--kart); border-radius: 10px; overflow: hidden;
    border: 3px solid transparent;
  }
  .poster img { width: 100%; height: 100%; display: block; object-fit: cover; }
  .poster .yok {
    position: absolute; top: 50%; left: 0; right: 0; margin-top: -10px;
    text-align: center; font-size: 19px; color: var(--sonuk);
    white-space: normal; padding: 0 10px;
  }
  .ilerleme { position: absolute; left: 0; right: 0; bottom: 0; height: 5px; background: rgba(0,0,0,.55); }
  .ilerleme i { display: block; height: 100%; background: var(--vurgu); }
  .kart-ad {
    font-size: 20px; margin-top: 10px; color: var(--sonuk);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .kart.odak { transform: scale(.97); }
  .kart.odak .poster { border-color: #fff; box-shadow: 0 0 0 4px var(--vurgu), 0 10px 28px rgba(0,0,0,.7); }
  .kart.odak .kart-ad { color: #fff; font-weight: 600; }

  /* Bölüm listesi */
  #bolumler { position: absolute; top: 0; left: 0; right: 0; bottom: 0; padding: 48px; overflow: hidden; }
  #bolum-ad { font-size: 34px; margin: 0 0 24px; }
  #bolum-kaydir { transition: transform .22s ease-out; }
  .bolum {
    display: block; padding: 16px 22px; margin-bottom: 10px; border-radius: 10px;
    background: var(--kart); font-size: 26px; border: 4px solid transparent;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .bolum.odak { border-color: #fff; background: #2e2a4a; color: #fff; }

  /* Arama */
  #arama { position: absolute; top: 0; left: 0; right: 0; bottom: 0; padding: 40px 48px; overflow: hidden; }
  #q {
    width: 100%; padding: 18px 22px; font-size: 26px; border-radius: 12px;
    border: 3px solid #3a3f4b; background: var(--kart); color: var(--yazi); outline: none;
  }
  #q:focus { border-color: #fff; }
  #arama-bilgi { margin: 14px 2px 18px; font-size: 22px; color: var(--sonuk); }
  #sonuclar { white-space: normal; }
  #sonuclar .kart { margin-bottom: 18px; }

  /* Oynatıcı */
  #oynatici { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: #000; }
  #video { width: 100%; height: 100%; background: #000; }
  #kaplama {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 40px 48px 36px;
    background: linear-gradient(to top, rgba(0,0,0,.92), rgba(0,0,0,0));
    transition: opacity .25s;
  }
  #kaplama.sonuk { opacity: 0; }
  #oynatilan { font-size: 32px; margin-bottom: 14px; }
  #cubuk { height: 10px; background: rgba(255,255,255,.22); border-radius: 4px; }
  #dolu { height: 100%; width: 0; background: var(--vurgu); border-radius: 4px; }
  #sure { margin-top: 12px; font-size: 26px; color: var(--yazi); }

  /* Durum / yükleniyor */
  #durum {
    position: absolute; top: 50%; left: 0; right: 0; margin-top: -30px;
    text-align: center; font-size: 30px; color: var(--yazi); z-index: 9;
    text-shadow: 0 2px 8px #000;
  }
  #durum.gizli { display: none; }
</style>
</head>
<body>

<div id="ust"><span class="marka">Net<em>Movies</em></span><span id="ipucu">OK: aç · basılı tut: ★ · <b style="color:#e5484d">●</b> ara · <b style="color:#30a46c">●</b> favoriler · <b style="color:#f5d90a">●</b> devam et</span></div>

<div id="raflar"><div id="kaydir"></div></div>

<div id="arama" class="gizli">
  <input id="q" type="text" placeholder="Film veya dizi ara…" autocomplete="off">
  <div id="arama-bilgi">Yaz ve OK'a bas · GERİ ile çık</div>
  <div id="sonuclar"></div>
</div>

<div id="bolumler" class="gizli">
  <h2 id="bolum-ad"></h2>
  <div id="bolum-kaydir"></div>
</div>

<div id="oynatici" class="gizli">
  <video id="video" preload="auto"></video>
  <div id="kaplama">
    <div id="oynatilan"></div>
    <div id="cubuk"><div id="dolu"></div></div>
    <div id="sure"></div>
  </div>
</div>

<div id="durum">Yükleniyor…</div>

<script>
(function () {
  "use strict";

  // Kumanda tuşları. webOS GERİ = 461; klavye/emülatör için Backspace ve Esc de
  // aynı işi görsün diye listede.
  var TUS = { SOL: 37, YUKARI: 38, SAG: 39, ASAGI: 40, OK: 13, GERI: 461, BACKSPACE: 8, ESC: 27,
              OYNAT: 415, DURAKLAT: 19, OYNATDURAKLAT: 179, ILERI: 417, GERISAR: 412, STOP: 413,
              // Renkli tuşlar webOS ve Tizen'de aynı (403-406). CH: webOS 33/34, Tizen 427/428.
              KIRMIZI: 403, YESIL: 404, SARI: 405, MAVI: 406,
              CH_YUKARI: 33, CH_ASAGI: 34, CH_YUKARI_T: 427, CH_ASAGI_T: 428 };

  var $ = function (id) { return document.getElementById(id); };

  // --- durum -------------------------------------------------------------
  var raflar   = [];          // [{ad, tur, kartlar:[...]}]
  var rafIdx   = 0;
  var kartIdx  = 0;
  var ekran    = "ana";       // ana | bolumler | oynatici
  var bolumler = [];
  var bolumIdx = 0;
  var acilan   = null;        // bölüm listesi hangi içeriğe ait
  var oynayan  = null;        // { kart, bolum, sure }
  var kaplamaZaman = 0;
  var sarHedef = null;        // birikmiş sarma hedefi (sn); null = sarma yok
  var sarZaman = 0;
  var sonuclar = [];          // arama sonucu kartları
  var sonucIdx = 0;
  var SUTUN    = 7;           // arama ızgarasında satır başına kart
  var GORUNEN  = 7;           // rafta ekrana sığan kart (client-tv RafPosterAdedi)
  var okBasildi = false;      // OK basılı tutuldu mu (favori) — bırakışta "aç" yutulur
  var sonKlavye = 0;          // son tuş/tekerlek zamanı — hover odağı çalmasın
  var sonFare   = 0;          // son GERÇEK fare hareketi

  function durum(metin) {
    var d = $("durum");
    if (!metin) { d.className = "gizli"; return; }
    d.className = ""; d.textContent = metin;
  }

  // --- ağ ----------------------------------------------------------------
  function api(yol) {
    return fetch(yol, { credentials: "same-origin" }).then(function (y) {
      if (!y.ok) throw new Error(yol + " → " + y.status);
      return y.json();
    });
  }

  // Sunucu kaydı: raflardaki "Devam Et" ve telefon/TV arası süreklilik bunu okur.
  function ilerlemeYaz(bitti) {
    if (!oynayan || !oynayan.kart) return;
    var v = $("video");
    if (!v.duration || v.duration < 1) return;
    var k = oynayan.kart;
    var p = new URLSearchParams();
    p.append("plugin", k.plugin || "");
    p.append("title", k.title || "");
    p.append("poster", k.poster || "");
    p.append("media_type", k.tur === "serie" ? "serie" : "movie");
    p.append("content_url", k.ham || "");
    p.append("episode", oynayan.bolumRef || "0");
    p.append("position_seconds", String(bitti ? v.duration : v.currentTime));
    p.append("duration_seconds", String(v.duration));
    fetch("/api/v1/progress?" + p.toString(), { method: "POST", credentials: "same-origin" })
      .catch(function () { /* ağ yoksa sessiz geç: oynatma bundan etkilenmez */ });
  }

  // --- veri --------------------------------------------------------------
  // `url` alanı katalogda quote_plus ile KODLANMIŞ gelir; çözülmüş hâli yalnız
  // ilerleme kaydında (content_url) kullanılır.
  function kartYap(ham, tur) {
    return {
      plugin : ham.plugin || "",
      title  : ham.title || "",
      poster : ham.poster || "",
      url    : ham.url || "",
      ham    : ham.content_url || decodeURIComponent(ham.url || ""),
      tur    : ham.tur_sat || tur,
      oran   : ham.oran || 0
    };
  }

  function rafGetir(ad, tur, yol, cikar) {
    return api(yol).then(function (y) {
      var kartlar = cikar(y).map(function (h) { return kartYap(h, tur); });
      return { ad: ad, tur: tur, kartlar: kartlar };
    }).catch(function () { return { ad: ad, tur: tur, kartlar: [] }; });
  }

  function devamKartlari(y) {
    return (y.result || []).map(function (r) {
      var oran = r.duration_seconds > 0 ? r.position_seconds / r.duration_seconds : 0;
      return {
        plugin: r.plugin, title: r.title, poster: r.poster,
        url: encodeURIComponent(r.content_url || ""),
        content_url: r.content_url, oran: oran
      };
    });
  }

  function katalogKartlari(y) { return ((y.result || {}).items) || []; }

  // Favori kaydı Devam Et ile aynı şekli taşır; tür kayıtta yazılı olduğu için
  // rafın genel türü yerine satırın kendi türü kullanılır.
  function favoriKartlari(y) {
    return (y.result || []).map(function (r) {
      return {
        plugin: r.plugin, title: r.title, poster: r.poster,
        url: encodeURIComponent(r.content_url || ""), content_url: r.content_url,
        tur_sat: r.media_type === "serie" ? "serie" : "movie"
      };
    });
  }

  function veriYukle() {
    durum("Yükleniyor…");
    return Promise.all([
      rafGetir("Devam Et",      "movie", "/api/v1/continue_watching?limit=20",        devamKartlari),
      rafGetir("Favorilerim",   "movie", "/api/v1/favorites",                          favoriKartlari),
      rafGetir("Yeni Filmler",  "movie", "/api/v1/aggregate_new?type=movie&page=1",   katalogKartlari),
      rafGetir("Yeni Diziler",  "serie", "/api/v1/aggregate_new?type=serie&page=1",   katalogKartlari),
      rafGetir("Türk Dizileri", "serie", "/api/v1/aggregate_new?type=serie_local&page=1", katalogKartlari)
    ]).then(function (sonuc) {
      raflar = sonuc.filter(function (r) { return r.kartlar.length > 0; });
      if (!raflar.length) { durum("İçerik yüklenemedi — sunucuya ulaşılamıyor"); return; }
      durum("");
      ciz();
      odakla(0, 0);
    });
  }

  // --- çizim -------------------------------------------------------------
  function ciz() {
    var kok = $("kaydir");
    kok.innerHTML = "";
    raflar.forEach(function (raf, ri) {
      var d = document.createElement("div");
      d.className = "raf"; d.id = "raf" + ri;
      var ad = document.createElement("div");
      ad.className = "raf-ad"; ad.textContent = raf.ad;
      var serit = document.createElement("div");
      serit.className = "serit"; serit.id = "serit" + ri;

      raf.kartlar.forEach(function (kart, ki) {
        var k = document.createElement("div");
        k.className = "kart"; k.id = "k" + ri + "_" + ki;
        var p = document.createElement("div");
        p.className = "poster";
        posterKur(p, kart);
        if (kart.oran > 0.01) {
          var c = document.createElement("div"); c.className = "ilerleme";
          var i = document.createElement("i"); i.style.width = Math.min(100, kart.oran * 100) + "%";
          c.appendChild(i); p.appendChild(c);
        }
        var ad2 = document.createElement("div");
        ad2.className = "kart-ad"; ad2.textContent = kart.title;
        k.appendChild(p); k.appendChild(ad2);
        // Magic Remote: imleç kartın üstüne gelince odak oraya taşınır, tıklama
        // OK ile aynı. Odak JS'te tutulduğu için fare de aynı kapıdan geçmeli.
        (function (ri2, ki2) {
          k.addEventListener("mouseenter", function () { if (ekran === "ana" && fareSahip()) odakla(ri2, ki2, false); });
          k.addEventListener("click", function () {
            // Uzun basış favoriyi işledi: bırakışta gelen tıklama içeriği açmasın.
            if (okBasildi) { okBasildi = false; return; }
            if (ekran === "ana") { odakla(ri2, ki2, false); sec(); }
          });
          basiliBagla(k, function () { return raflar[ri2].kartlar[ki2]; });
        })(ri, ki);
        serit.appendChild(k);
      });

      d.appendChild(ad); d.appendChild(serit);
      kok.appendChild(d);
    });
  }

  // Poster DOĞRUDAN kaynaktan istenmez: TV'nin DNS'i kimi Cloudflare sitelerini
  // TR'de engelli IP'ye çözüyor (LG'den jetfilmizle/hdfilmcehennemi/diziyou: bağlantı
  // yok), kart adla kalıyordu. /proxy/image sunucuda kaynak → cache → TMDB → yer tutucu
  // zincirini çalıştırır (web ve Android TV aynı adresi kullanır).
  function posterAdres(kart) {
    if (!kart.poster && !kart.title) return "";
    return "/proxy/image?url=" + encodeURIComponent(kart.poster || "") +
           "&title=" + encodeURIComponent(kart.title || "");
  }

  // Tembel yükleme: sayfa ~440 poster taşıyor; hepsini birden istemek sunucunun
  // dakikalık istek sınırını (180) aşıp 429'la posterleri düşürüyor, eski TV'yi de
  // yoruyordu. Yalnız görünen ve bir sonraki sayfa yüklenir.
  function posterYukle(el) {
    if (!el) return;
    var img = el.querySelector("img[data-src]");
    if (!img) return;
    img.src = img.getAttribute("data-src");
    img.removeAttribute("data-src");
  }

  function posterKur(p, kart) {
    var adres = posterAdres(kart);
    if (!adres) { yazili(p, kart.title); return; }
    var img = document.createElement("img");
    img.setAttribute("data-src", adres);
    // Kırık poster kartı boş bırakmasın: başlık yazısına düş.
    img.onerror = function () { if (img.parentNode) p.removeChild(img); yazili(p, kart.title); };
    p.appendChild(img);
  }

  function yazili(p, baslik) {
    var y = document.createElement("div");
    y.className = "yok"; y.textContent = baslik || "POSTER YOK";
    p.appendChild(y);
  }

  // `kaydirma=false`: odak fareden geldi. İmleç kartın üstündeyken şeridi
  // kaydırmak kartı imlecin altından çekiyor, bir sonraki karta atlıyor ve
  // liste imleç durmadan akıyordu (Dean: "yağ gibi durmuyor").
  function odakla(ri, ki, kaydirma) {
    var eski = document.querySelector(".kart.odak");
    if (eski) eski.className = "kart";
    rafIdx = Math.max(0, Math.min(ri, raflar.length - 1));
    kartIdx = Math.max(0, Math.min(ki, raflar[rafIdx].kartlar.length - 1));
    var k = $("k" + rafIdx + "_" + kartIdx);
    if (k) k.className = "kart odak";

    if (kaydirma !== false) {
      // Yatay: odaklı kart soldan üçüncü sıraya oturur (ilk ikisinde kaydırma yok).
      var ilk = $("k" + rafIdx + "_0"), sol = $("k" + rafIdx + "_" + Math.max(0, kartIdx - 2));
      var serit = $("serit" + rafIdx);
      if (serit && ilk && sol) serit.style.transform = "translateX(-" + (sol.offsetLeft - ilk.offsetLeft) + "px)";

      // Dikey: etkin raf üstten ikinci sıraya oturur.
      // Konum ÖLÇÜLÜR: sabit raf yüksekliği yazı boyutu/margin çöküşüyle kayıyor, alt raf taşıyordu.
      var ust = rafIdx > 0 ? $("raf" + (rafIdx - 1)) : null;
      $("kaydir").style.transform = "translateY(-" + (ust ? ust.offsetTop : 0) + "px)";
    }

    for (var i = 0; i < raflar.length; i++) {
      var e = $("raf" + i);
      if (e) e.className = i === rafIdx ? "raf etkin" : "raf";
    }
    // Ekrandaki raflar (üstteki, etkin, alttaki iki) + bir sayfa ileri.
    for (var r = Math.max(0, rafIdx - 1); r <= Math.min(raflar.length - 1, rafIdx + 2); r++) {
      var son = (r === rafIdx ? kartIdx : 0) + 2 * GORUNEN;
      for (var j = 0; j <= son; j++) posterYukle($("k" + r + "_" + j));
    }
  }

  // --- oynatma -----------------------------------------------------------
  // `encoded_url` sunucuya OLDUĞU GİBİ gider. Katalog değeri zaten quote_plus ile
  // kodlu; URLSearchParams onu bir kez daha kodlayınca (%3A → %253A) engine adresi
  // çözemiyor ve zincir sessizce boş dönüyor — ekranda "kaynak bulunamadı".
  function zincirYolu(kart, bolumSira, mod) {
    return "/api/v1/resolve_sources?plugin=" + encodeURIComponent(kart.plugin) +
           "&encoded_url=" + kart.url +
           "&title=" + encodeURIComponent(kart.title || "") +
           "&episode=" + (bolumSira || 0) +
           "&mode=" + (mod || "fast");
  }

  // Seçili sağlayıcı çökünce (ör. site 522) fast boş döner; APK gibi alternatif
  // sağlayıcılara (mode=full) düş, yoksa ekranda "kaynak bulunamadı" kalıyordu.
  function zincir(kart, bolumSira) {
    return api(zincirYolu(kart, bolumSira, "fast")).then(function (y) {
      var r = y.result || {};
      if ((r.sources || []).length || (r.episodes || []).length) return y;
      durum("Alternatif sağlayıcılar aranıyor…");
      return api(zincirYolu(kart, bolumSira, "full"));
    });
  }

  function sec() {
    var kart = raflar[rafIdx].kartlar[kartIdx];
    if (!kart) return;
    if (kart.tur === "serie") { bolumAc(kart); return; }
    oynat(kart, 0, "0");
  }

  // Bölüm listesi resolve_sources'un YAN ÜRÜNÜ: ayrı uç yok, zincir zaten
  // diziyi çözerken bölümleri de döndürüyor.
  function bolumAc(kart) {
    durum("Bölümler alınıyor…");
    zincir(kart, 0).then(function (y) {
      var r = (y.result || {});
      bolumler = r.episodes || [];
      if (!bolumler.length) {
        // Bölüm yoksa kart zaten tek bir bölüm/film sayfasıdır: doğrudan oynat.
        durum("");
        oynatKaynakla(kart, r.sources || [], "0");
        return;
      }
      durum("");
      acilan = kart;
      bolumCiz();
      ekran = "bolumler";
      $("raflar").className = "gizli";
      $("bolumler").className = "";
    }).catch(function () { durum("Bölümler alınamadı"); setTimeout(function () { durum(""); }, 2500); });
  }

  function bolumCiz() {
    var kok = $("bolum-kaydir");
    kok.innerHTML = "";
    $("bolum-ad").textContent = acilan.title;
    bolumler.forEach(function (b, i) {
      var d = document.createElement("div");
      d.className = "bolum"; d.id = "b" + i;
      var s = b.season || 1;
      var e = (b.episode === null || b.episode === undefined) ? (i + 1) : b.episode;
      d.textContent = "S" + s + " B" + e + (b.title ? " · " + b.title : "");
      (function (i2) {
        d.addEventListener("mouseenter", function () { if (fareSahip()) bolumOdak(i2); });
        d.addEventListener("click", function () { bolumOdak(i2); bolumOynat(); });
      })(i);
      kok.appendChild(d);
    });
    bolumIdx = 0;
    bolumOdak(0);
  }

  function bolumOdak(i) {
    var eski = document.querySelector(".bolum.odak");
    if (eski) eski.className = "bolum";
    bolumIdx = Math.max(0, Math.min(i, bolumler.length - 1));
    var d = $("b" + bolumIdx);
    if (d) d.className = "bolum odak";
    var satirY = d ? d.offsetHeight + 10 : 72;
    $("bolum-kaydir").style.transform = "translateY(-" + (Math.max(0, bolumIdx - 5) * satirY) + "px)";
    var b = bolumler[bolumIdx];
    if (b) {
      $("bolum-ad").textContent = acilan.title + "  ·  " +
        "S" + (b.season || 1) + " B" +
        ((b.episode === null || b.episode === undefined) ? (bolumIdx + 1) : b.episode) +
        "  (" + (bolumIdx + 1) + "/" + bolumler.length + ")  ·  ←→ 10 atla";
    }
  }

  function oynat(kart, bolumSira, bolumRef) {
    durum("Kaynak aranıyor…");
    // YouTube zincirden geçmez: tek adresi yt-dlp çözer ve HLS master döner —
    // 1080p/4K rendition'ları televizyonun kendi medya motoru seçer.
    if (kart.plugin === "youtube") {
      api("/api/v1/ytdlp-extract?url=" + encodeURIComponent(kart.ham)).then(function (y) {
        var r = y.result || {};
        oynatKaynakla(kart, r.stream_url ? [{ url: r.stream_url }] : [], "0");
      }).catch(function () {
        durum("YouTube kaynağı alınamadı");
        setTimeout(function () { durum(""); }, 2500);
      });
      return;
    }
    zincir(kart, bolumSira).then(function (y) {
      oynatKaynakla(kart, ((y.result || {}).sources) || [], bolumRef);
    }).catch(function () { durum("Kaynak alınamadı"); setTimeout(function () { durum(""); }, 2500); });
  }

  function oynatKaynakla(kart, kaynaklar, bolumRef) {
    if (!kaynaklar.length) {
      durum("Oynatılabilir kaynak bulunamadı");
      setTimeout(function () { durum(""); }, 3000);
      return;
    }
    durum("");
    oynayan = { kart: kart, bolumRef: bolumRef || "0", kaynaklar: kaynaklar, sira: 0, tekrar: 0, tekrarKonum: 0 };
    var v = $("video");
    // webOS'un kendi medya motoru HLS'i doğrudan açar; hls.js gerekmiyor.
    v.src = kaynaklar[0].url;
    gunlukYaz("BAŞLA " + kart.plugin + " · " + kart.title + " · " + kaynakHost(v.src) + " · " + kaynaklar.length + " kaynak");
    $("oynatilan").textContent = kart.title + (bolumRef && bolumRef !== "0" ? " · " + bolumRef : "");
    ekran = "oynatici";
    $("raflar").className = "gizli";
    $("bolumler").className = "gizli";
    $("oynatici").className = "";
    $("ust").className = "gizli";
    kaplamaGoster();
    v.play();
    devamdanBasla(kart, bolumRef);
  }

  // Aynı ya da başka kaynağı KALDIĞI YERDEN yeniden kurar: hata ya da mavi tuş.
  function kaynakKur(sira, konum) {
    var v = $("video");
    oynayan.sira = sira;
    v.src = oynayan.kaynaklar[sira].url;
    var git = function () {
      v.removeEventListener("loadedmetadata", git);
      if (konum > 1) v.currentTime = konum;
    };
    v.addEventListener("loadedmetadata", git);
    v.play();
  }

  // Mavi tuş: sıradaki kaynağa geç (tek kaynak varsa aynısını yeniden kur).
  function kaynakDegistir() {
    if (!oynayan || !oynayan.kaynaklar) return;
    var n = oynayan.kaynaklar.length;
    var sira = (oynayan.sira + 1) % n;
    bildir("Kaynak " + (sira + 1) + "/" + n);
    gunlukYaz("KAYNAK DEĞİŞ → " + (sira + 1) + "/" + n);
    oynayan.tekrar = 0;
    kaynakKur(sira, $("video").currentTime);
  }

  function oynatmaKapat() {
    var v = $("video");
    if (sarZaman) { clearTimeout(sarZaman); sarZaman = 0; }
    sarHedef = null;
    ilerlemeYaz(false);
    if (oynayan) { gunlukYaz("KAPAT"); gunlukGonder(); }
    if (bekleBas) { bekleBas = 0; durum(""); }
    v.pause();
    v.removeAttribute("src");
    v.load();
    oynayan = null;
    $("oynatici").className = "gizli";
    $("ust").className = "";
    if (acilan) { $("bolumler").className = ""; ekran = "bolumler"; }
    else { $("raflar").className = ""; ekran = "ana"; }
  }

  function kaplamaGoster() {
    $("kaplama").className = "";
    kaplamaZaman = Date.now();
  }

  function zaman(sn) {
    if (!sn || sn < 0) sn = 0;
    var s = Math.floor(sn % 60), d = Math.floor(sn / 60) % 60, h = Math.floor(sn / 3600);
    var iki = function (n) { return n < 10 ? "0" + n : String(n); };
    return (h > 0 ? h + ":" : "") + iki(d) + ":" + iki(s);
  }

  // Sarma basışları HEDEFTE birikir: art arda üç kez basmak 30 sn sarar, üç ayrı
  // seekTo değil. Her seekTo HLS'te yeni segment indirmesi demek — üst üste
  // basınca oynatıcı her basışta baştan tamponluyordu.
  function sar(saniye) {
    var v = $("video");
    if (!v.duration) return;
    var taban = (sarHedef === null) ? v.currentTime : sarHedef;
    sarHedef = Math.max(0, Math.min(v.duration - 1, taban + saniye));
    $("dolu").style.width = (sarHedef / v.duration * 100) + "%";
    $("sure").textContent = zaman(sarHedef) + " / " + zaman(v.duration) +
                            "  (" + (saniye > 0 ? "+" : "") + Math.round(sarHedef - v.currentTime) + "sn)";
    kaplamaGoster();
    if (sarZaman) clearTimeout(sarZaman);
    sarZaman = setTimeout(function () {
      if (sarHedef !== null) v.currentTime = sarHedef;
      sarHedef = null; sarZaman = 0;
    }, 600);
  }

  // Kaldığın yer SUNUCUDA: telefonda, Android TV'de ya da burada bıraktığın
  // dakika aynı kayıttan okunur. Başlangıçtaki birkaç saniye ve neredeyse biten
  // içerik atlanır — yoksa jenerikten açılır.
  function devamdanBasla(kart, bolumRef) {
    var yol = "/api/v1/progress?title=" + encodeURIComponent(kart.title || "") +
              "&media_type=" + (kart.tur === "serie" ? "serie" : "movie");
    api(yol).then(function (y) {
      var r = y.result;
      if (!r || !r.position_seconds) return;
      // Kayıt BAŞKA bir bölüme aitse konuma atlama: 5. bölümü açarken 7. bölümün
      // dakikasına gitmek içeriği ortadan başlatır.
      if (bolumRef && bolumRef !== "0" && r.episode && r.episode !== bolumRef) return;
      var v = $("video");
      // Tek seferlik: dinleyici kalırsa sonraki filmde / hata sonrası yeniden
      // kurulumda eski konuma atlatıyordu.
      var uygula = function () {
        v.removeEventListener("loadedmetadata", uygula);
        if (!v.duration || oynayan === null || oynayan.kart !== kart) return;
        if (r.position_seconds > 30 && r.position_seconds < v.duration * 0.92) {
          v.currentTime = r.position_seconds;
          $("oynatilan").textContent += "  ▶ " + zaman(r.position_seconds) + " konumundan devam";
        }
      };
      if (v.duration) { uygula(); } else { v.addEventListener("loadedmetadata", uygula); }
    }).catch(function () { /* kayıt yoksa baştan oynar */ });
  }

  function bolumOynat() {
    var b = bolumler[bolumIdx];
    if (!b) return;
    // Bölüm kaydı SIRA değil, "S4B8" biçiminde yazılır: liste değişince
    // "123. bölüm" diye kayda geçmesin.
    var ref = "S" + (b.season || 1) + "B" +
              ((b.episode === null || b.episode === undefined) ? (bolumIdx + 1) : b.episode);
    oynat(acilan, bolumIdx, ref);
  }

  // --- arama -------------------------------------------------------------
  // Ana ekranın EN ÜST rafındayken YUKARI: televizyon arayüzlerinin alışılmış
  // yeri. Ayrı bir tuş yok — kumandada renkli tuşlara güvenilmiyor.
  function aramaAc() {
    ekran = "arama";
    $("raflar").className = "gizli";
    $("arama").className = "";
    var q = $("q");
    q.value = "";
    $("sonuclar").innerHTML = "";
    sonuclar = []; sonucIdx = 0;
    $("arama-bilgi").textContent = "Yaz ve OK'a bas · GERİ ile çık";
    // Odak girişte: webOS sanal klavyesi böyle açılır.
    setTimeout(function () { q.focus(); }, 60);
  }

  function aramaYap() {
    var q = $("q").value.trim();
    if (!q) return;
    $("q").blur();
    $("arama-bilgi").textContent = "Aranıyor: " + q;
    api("/api/v1/search_all?query=" + encodeURIComponent(q)).then(function (y) {
      var ham = y.result || [];
      // Tip kartın kendisinden gelir: bölüm sayısı olan dizidir, bölüm listesi
      // açılır; olmayan doğrudan oynar.
      sonuclar = ham.map(function (h) {
        return kartYap(h, (h.episode_count || h.season_count) ? "serie" : "movie");
      });
      $("arama-bilgi").textContent = sonuclar.length
        ? sonuclar.length + " sonuç · OK aç, GERİ çık"
        : "Sonuç yok: " + q;
      sonucCiz();
    }).catch(function () { $("arama-bilgi").textContent = "Arama başarısız — sunucuya ulaşılamadı"; });

    // YouTube ayrı ve yavaş: katalog sonuçları beklemez, gelince listenin sonuna
    // eklenir. Odak korunur, yoksa gezinirken imleç başa sıçrar.
    api("/api/v1/youtube_search?query=" + encodeURIComponent(q) + "&limit=18").then(function (y) {
      var videolar = y.result || [];
      if (!videolar.length || $("q").value.trim() !== q) return;
      videolar.forEach(function (v) {
        sonuclar.push({
          plugin : "youtube",
          title  : "▶ " + v.title,
          poster : v.poster || "",
          url    : encodeURIComponent(v.url),
          ham    : v.url,
          tur    : "movie",
          oran   : 0
        });
      });
      var odak = sonucIdx;
      sonucCiz();
      sonucOdak(odak);
      $("arama-bilgi").textContent = sonuclar.length + " sonuç (YouTube dahil) · OK aç, GERİ çık";
    }).catch(function () { /* YouTube yoksa katalog sonuçları yeterli */ });
  }

  function sonucCiz() {
    var kok = $("sonuclar");
    kok.innerHTML = "";
    sonuclar.forEach(function (kart, i) {
      var k = document.createElement("div");
      k.className = "kart"; k.id = "s" + i;
      var p = document.createElement("div");
      p.className = "poster";
      posterKur(p, kart);
      var ad = document.createElement("div");
      ad.className = "kart-ad"; ad.textContent = kart.title;
      k.appendChild(p); k.appendChild(ad);
      (function (i2) {
        k.addEventListener("mouseenter", function () { if (fareSahip()) sonucOdak(i2); });
        k.addEventListener("click", function () {
          if (okBasildi) { okBasildi = false; return; }
          sonucOdak(i2); sonucSec();
        });
        basiliBagla(k, function () { return sonuclar[i2]; });
      })(i);
      kok.appendChild(k);
    });
    sonucIdx = 0;
    if (sonuclar.length) sonucOdak(0);
  }

  function sonucOdak(i) {
    var eski = document.querySelector("#sonuclar .kart.odak");
    if (eski) eski.className = "kart";
    sonucIdx = Math.max(0, Math.min(i, sonuclar.length - 1));
    var k = $("s" + sonucIdx);
    if (k) k.className = "kart odak";
    // Izgara üçüncü satırdan sonra kayar; giriş kutusu ekranda kalsın diye
    // konteyner değil sonuç listesi kaydırılır.
    var satir = Math.floor(sonucIdx / SUTUN);
    var satirY = k ? k.offsetHeight + 18 : 340;
    for (var j = 0; j < (satir + 3) * SUTUN; j++) posterYukle($("s" + j));
    $("sonuclar").style.transform = "translateY(-" + (Math.max(0, satir - 1) * satirY) + "px)";
  }

  function sonucSec() {
    var kart = sonuclar[sonucIdx];
    if (!kart) return;
    if (kart.tur === "serie") { bolumAc(kart); return; }
    oynat(kart, 0, "0");
  }

  // --- favori ------------------------------------------------------------
  // OK'a BASILI TUTMAK listeye ekler/çıkarır; kısa basış açar. Kumandada ayrı
  // tuş yok, aramada bulduğunu her seferinde yeniden aramak zorunda kalmamak
  // için tek yol bu.
  // Magic Remote imleci açıkken kumandanın OK'u sayfaya keydown olarak GELMİYOR,
  // fare olayına dönüşüyor: favori için kullanılan keydown.repeat hiç tetiklenmiyor
  // ve poster basılı tutmak işlemiyordu. Fare tarafı kendi süresini ölçer.
  var basSayac = 0;

  function basiliBagla(el, kartAl) {
    el.addEventListener("mousedown", function () {
      if (basSayac) clearTimeout(basSayac);
      basSayac = setTimeout(function () {
        basSayac = 0; okBasildi = true; favoriDegistir(kartAl());
      }, 600);
    });
    el.addEventListener("mouseup", function () {
      if (basSayac) { clearTimeout(basSayac); basSayac = 0; }
    });
  }

  function favoriDegistir(kart) {
    if (!kart) return;
    var yol = "/api/v1/favorites/toggle?title=" + encodeURIComponent(kart.title || "") +
              "&plugin=" + encodeURIComponent(kart.plugin || "") +
              "&poster=" + encodeURIComponent(kart.poster || "") +
              "&media_type=" + (kart.tur === "serie" ? "serie" : "movie") +
              "&content_url=" + encodeURIComponent(kart.ham || "");
    bildir("★ " + kart.title + " → listeye işleniyor…");
    fetch(yol, { method: "POST", credentials: "same-origin" })
      .then(function (y) { return y.json(); })
      .then(function (j) {
        var eklendi = !!(j && j.result && j.result.is_favorite);
        bildir(eklendi ? "★ Favorilere eklendi: " + kart.title
                       : "☆ Favorilerden çıkarıldı: " + kart.title);
        favoriRafiTazele();
      })
      .catch(function () { bildir("Favori kaydedilemedi — sunucuya ulaşılamadı"); });
  }

  var bildirimZaman = 0;
  function bildir(metin) {
    durum(metin);
    if (bildirimZaman) clearTimeout(bildirimZaman);
    bildirimZaman = setTimeout(function () { durum(""); bildirimZaman = 0; }, 2200);
  }

  // Favori rafı yerinde tazelenir: ekleme sonrası tüm katalog yeniden çekilmez,
  // ana ekrana dönünce liste güncel olsun yeter.
  function favoriRafiTazele() {
    api("/api/v1/favorites").then(function (y) {
      var kartlar = (y.result || []).map(function (r) {
        return kartYap({
          plugin: r.plugin, title: r.title, poster: r.poster,
          url: encodeURIComponent(r.content_url || ""), content_url: r.content_url
        }, r.media_type === "serie" ? "serie" : "movie");
      });
      var yer = -1;
      for (var i = 0; i < raflar.length; i++) if (raflar[i].ad === "Favorilerim") { yer = i; break; }
      if (!kartlar.length) { if (yer >= 0) raflar.splice(yer, 1); }
      else if (yer >= 0) { raflar[yer].kartlar = kartlar; }
      else { raflar.splice(1, 0, { ad: "Favorilerim", tur: "movie", kartlar: kartlar }); }
      var eskiRaf = rafIdx, eskiKart = kartIdx;
      ciz();
      odakla(Math.min(eskiRaf, raflar.length - 1), eskiKart);
    }).catch(function () { /* ağ yoksa raf olduğu gibi kalır */ });
  }

  // Geri: tek karar noktası. Hem kumandanın GERİ tuşu hem de webOS'un geçmiş
  // olayı (popstate) buraya düşer — `disableBackHistoryAPI` kapalı kalan bir
  // webOS sürümünde tuş sayfaya keydown olarak hiç gelmiyor, sistem geçmişi
  // geri alıyor. İki yol da aynı işi yapsın diye ayrıldı.
  function geriGit() {
    if (ekran === "oynatici") { oynatmaKapat(); return; }
    if (ekran === "arama") {
      ekran = "ana";
      $("arama").className = "gizli"; $("raflar").className = "";
      return;
    }
    if (ekran === "bolumler") {
      acilan = null; ekran = "ana";
      $("bolumler").className = "gizli"; $("raflar").className = "";
      return;
    }
    // Ana ekrandayız: uygulamadan çıkmıyoruz, ilk rafın başına dönüyoruz.
    odakla(0, 0);
  }

  // Geçmişe bir tuzak girişi: sistem geri alırsa popstate tetiklenir, sayfa
  // sarmalayıcıya (index.html) düşmez.
  if (window.history && window.history.pushState) {
    window.history.pushState({ nm: 1 }, "");
    window.addEventListener("popstate", function () {
      window.history.pushState({ nm: 1 }, "");
      geriGit();
    });
  }

  // --- tuşlar ------------------------------------------------------------
  // Odak tarayıcıya bırakılmaz: TV'de odak grupları ok tuşunu yutup listeyi
  // başa sardırıyor. Tek karar noktası burası.
  // Rakam tuşu (üst sıra 48-57, sayısal 96-105) → 0-9; değilse -1.
  function rakam(k) {
    if (k >= 48 && k <= 57) return k - 48;
    if (k >= 96 && k <= 105) return k - 96;
    return -1;
  }
  var bilinen = {};
  Object.keys(TUS).forEach(function (a) { bilinen[TUS[a]] = 1; });

  function rafAd(ad) {
    for (var i = 0; i < raflar.length; i++) if (raflar[i].ad === ad) return i;
    return -1;
  }

  // Renkli tuşlar oynatıcı dışında her ekrandan: kırmızı ara, yeşil favoriler, sarı devam et.
  function renkliTus(k) {
    if (k !== TUS.KIRMIZI && k !== TUS.YESIL && k !== TUS.SARI) return false;
    if (ekran === "oynatici") return false;
    if (ekran !== "ana") geriGit();
    if (k === TUS.KIRMIZI) { aramaAc(); return true; }
    var i = rafAd(k === TUS.YESIL ? "Favorilerim" : "Devam Et");
    if (i >= 0) odakla(i, 0); else bildir(k === TUS.YESIL ? "Favori listesi boş" : "Devam edilecek içerik yok");
    return true;
  }

  document.addEventListener("keydown", function (o) {
    var k = o.keyCode;
    sonKlavye = Date.now();
    // Tanınmayan tuş günlüğe: yeni kumandanın kodu tahmin edilmez, okunur.
    if (!o.repeat && !bilinen[k] && rakam(k) < 0 && document.activeElement !== $("q")) gunlukYaz("TUŞ kod=" + k + " (" + (o.key || "") + ")");

    if (renkliTus(k)) { o.preventDefault(); return; }

    if (ekran === "oynatici") {
      var v = $("video");
      if (k === TUS.GERI || k === TUS.BACKSPACE || k === TUS.ESC || k === TUS.STOP) { geriGit(); o.preventDefault(); return; }
      if (k === TUS.OYNAT)    { v.play();  kaplamaGoster(); o.preventDefault(); return; }
      if (k === TUS.DURAKLAT) { v.pause(); kaplamaGoster(); o.preventDefault(); return; }
      if (k === TUS.OK || k === TUS.OYNATDURAKLAT) {
        if (o.repeat) { o.preventDefault(); return; }
        if (v.paused) { v.play(); } else { v.pause(); }
        kaplamaGoster(); o.preventDefault(); return;
      }
      if (k === TUS.SAG || k === TUS.ILERI)   { sar(10);  o.preventDefault(); return; }
      if (k === TUS.SOL || k === TUS.GERISAR) { sar(-10); o.preventDefault(); return; }
      if (k === TUS.CH_YUKARI || k === TUS.CH_YUKARI_T) { sar(60);  o.preventDefault(); return; }
      if (k === TUS.CH_ASAGI  || k === TUS.CH_ASAGI_T)  { sar(-60); o.preventDefault(); return; }
      if (k === TUS.MAVI) { kaynakDegistir(); o.preventDefault(); return; }
      // Rakam: filmin yüzde n×10'una git (YouTube alışkanlığı).
      if (rakam(k) >= 0 && v.duration) {
        sar(v.duration * rakam(k) / 10 - (sarHedef === null ? v.currentTime : sarHedef));
        o.preventDefault(); return;
      }
      if (k === TUS.YUKARI || k === TUS.ASAGI) { kaplamaGoster(); o.preventDefault(); return; }
      return;
    }

    if (ekran === "bolumler") {
      if (k === TUS.GERI || k === TUS.BACKSPACE || k === TUS.ESC) { geriGit(); o.preventDefault(); return; }
      if (k === TUS.ASAGI)  { bolumOdak(bolumIdx + 1);  o.preventDefault(); return; }
      if (k === TUS.YUKARI) { bolumOdak(bolumIdx - 1);  o.preventDefault(); return; }
      // Uzun dizilerde (43 bölüm) tek tek inmek yerine onar atla.
      if (k === TUS.SAG || k === TUS.CH_ASAGI || k === TUS.CH_ASAGI_T)   { bolumOdak(bolumIdx + 10); o.preventDefault(); return; }
      if (k === TUS.SOL || k === TUS.CH_YUKARI || k === TUS.CH_YUKARI_T) { bolumOdak(bolumIdx - 10); o.preventDefault(); return; }
      if (k === TUS.OK) { if (!o.repeat) bolumOynat(); o.preventDefault(); return; }
      return;
    }

    if (ekran === "arama") {
      if (k === TUS.GERI || k === TUS.BACKSPACE || k === TUS.ESC) { geriGit(); o.preventDefault(); return; }
      // Giriş kutusundayken oklar imleci hareket ettirir, sonuçlara karışmaz.
      if (document.activeElement === $("q")) {
        if (k === TUS.OK && !o.repeat) { aramaYap(); o.preventDefault(); }
        return;
      }
      if (!sonuclar.length) { if (k === TUS.OK || k === TUS.YUKARI) { $("q").focus(); o.preventDefault(); } return; }
      if (k === TUS.SAG)    { sonucOdak(sonucIdx + 1); o.preventDefault(); return; }
      if (k === TUS.SOL)    { sonucOdak(sonucIdx - 1); o.preventDefault(); return; }
      if (k === TUS.ASAGI)  { sonucOdak(sonucIdx + SUTUN); o.preventDefault(); return; }
      if (k === TUS.YUKARI) {
        // İlk satırdan yukarı = arama kutusuna dön.
        if (sonucIdx < SUTUN) { $("q").focus(); } else { sonucOdak(sonucIdx - SUTUN); }
        o.preventDefault(); return;
      }
      if (k === TUS.OK) {
        if (o.repeat) { if (!okBasildi) { okBasildi = true; favoriDegistir(sonuclar[sonucIdx]); } }
        o.preventDefault(); return;
      }
      return;
    }

    if (!raflar.length) return;
    if (k === TUS.CH_ASAGI || k === TUS.CH_ASAGI_T)   { odakla(rafIdx, kartIdx + GORUNEN); o.preventDefault(); return; }
    if (k === TUS.CH_YUKARI || k === TUS.CH_YUKARI_T) { odakla(rafIdx, kartIdx - GORUNEN); o.preventDefault(); return; }
    if (rakam(k) >= 1) { odakla(rakam(k) - 1, 0); o.preventDefault(); return; }
    if (k === TUS.SAG)    { odakla(rafIdx, kartIdx + 1); o.preventDefault(); return; }
    if (k === TUS.SOL)    { odakla(rafIdx, kartIdx - 1); o.preventDefault(); return; }
    if (k === TUS.ASAGI)  { odakla(rafIdx + 1, 0);       o.preventDefault(); return; }
    if (k === TUS.YUKARI) {
      if (rafIdx === 0) { aramaAc(); } else { odakla(rafIdx - 1, 0); }
      o.preventDefault(); return;
    }
    if (k === TUS.OK) {
      // Tekrar eden keydown = basılı tutma. Bırakışta (keyup) "aç" çalışmasın
      // diye bayrak bırakılır.
      if (o.repeat) {
        if (!okBasildi) { okBasildi = true; favoriDegistir(raflar[rafIdx].kartlar[kartIdx]); }
      }
      o.preventDefault(); return;
    }
  });

  // Magic Remote açıkken kumandanın OK'u sayfaya `keydown` olarak DEĞİL, imlecin
  // bulunduğu yere `click` olarak geliyor — oynatıcıda duraklatma bu yüzden
  // çalışmıyordu (Dean: "mouse aktifken orta tuş durdurmuyor"). Video alanına
  // gelen tıklama da aynı işi yapar.
  $("oynatici").addEventListener("click", function () {
    if (ekran !== "oynatici") return;
    var v = $("video");
    if (v.paused) { v.play(); } else { v.pause(); }
    kaplamaGoster();
  });

  // Açma işi BIRAKMADA: basılı tutma favoriye gittiği için kısa basış ancak
  // tuş bırakıldığında ayırt edilebiliyor.
  document.addEventListener("keyup", function (o) {
    if (o.keyCode !== TUS.OK) return;
    if (okBasildi) { okBasildi = false; o.preventDefault(); return; }
    if (ekran === "ana" && raflar.length) { sec(); o.preventDefault(); return; }
    if (ekran === "arama" && sonuclar.length && document.activeElement !== $("q")) {
      sonucSec(); o.preventDefault(); return;
    }
  });

  // --- imleç ve tekerlek -------------------------------------------------
  // İmleç kartın üstünde dururken liste tuşla/tekerlekle kayınca altına YENİ kart
  // gelir ve mouseenter odağı oraya çalar. Hover yalnız imleç gerçekten hareket
  // ediyorsa ve son tuştan 400 ms geçtiyse odak alır.
  document.addEventListener("mousemove", function () { sonFare = Date.now(); });
  function fareSahip() {
    var s = Date.now();
    return s - sonFare < 150 && s - sonKlavye > 400;
  }

  // Tekerlek sayfayı kaydırmaz, odağı adım adım taşır (tekerlekli kumanda).
  // Tek dönüş birkaç olay üretir; 180 ms'de bir adım.
  var tekerZaman = 0;
  document.addEventListener("wheel", function (o) {
    o.preventDefault();
    var s = Date.now();
    if (s - tekerZaman < 180) return;
    tekerZaman = s; sonKlavye = s;
    var yatay = Math.abs(o.deltaX) > Math.abs(o.deltaY);
    var ileri = (yatay ? o.deltaX : o.deltaY) > 0;
    if (ekran === "ana" && raflar.length) {
      if (yatay) odakla(rafIdx, kartIdx + (ileri ? 1 : -1));
      else odakla(rafIdx + (ileri ? 1 : -1), 0);
    } else if (ekran === "bolumler") {
      bolumOdak(bolumIdx + (ileri ? 1 : -1));
    } else if (ekran === "arama" && sonuclar.length) {
      sonucOdak(sonucIdx + (ileri ? SUTUN : -SUTUN));
    } else if (ekran === "oynatici") {
      kaplamaGoster();
    }
  }, { passive: false });

  // --- döngüler ----------------------------------------------------------
  setInterval(function () {
    if (ekran !== "oynatici") return;
    var v = $("video");
    if (!v.duration) return;
    if (sarHedef === null) {
      $("dolu").style.width = (v.currentTime / v.duration * 100) + "%";
      $("sure").textContent = zaman(v.currentTime) + " / " + zaman(v.duration);
    }
    // Kaplama 4 sn sonra söner; herhangi bir tuş geri getirir.
    if (!v.paused && Date.now() - kaplamaZaman > 4000) $("kaplama").className = "sonuk";
  }, 500);

  setInterval(function () { if (ekran === "oynatici") ilerlemeYaz(false); }, 15000);

  $("video").addEventListener("ended", function () { ilerlemeYaz(true); oynatmaKapat(); });
  // --- oynatma günlüğü --------------------------------------------------
  // /tv kördü: LG/Samsung'da "dondu" dendiğinde sunucuda iz yoktu (proxy istekleri
  // loglanmaz). Tampon olayları Android TV'nin kullandığı /api/v1/client_log'a
  // gider; uç tek dökümü tutar, bu yüzden her gönderim listenin tamamıdır.
  var gunluk = [], gunlukSayac = 0, bekleBas = 0;
  var cihazAd = "/tv " + ((/(Tizen [\d.]+|Web0S|webOS[\w.\/]*)/.exec(navigator.userAgent) || ["tarayıcı"])[0]);

  function kaynakHost(src) {
    var m = /[?&]url=([^&]+)/.exec(src || "");
    try { return m ? decodeURIComponent(m[1]).split("/")[2] : String(src).split("/")[2]; } catch (e) { return "?"; }
  }

  function tamponIleri(v) {
    for (var i = 0; i < v.buffered.length; i++) {
      if (v.buffered.start(i) <= v.currentTime + 0.5 && v.currentTime <= v.buffered.end(i)) return v.buffered.end(i) - v.currentTime;
    }
    return 0;
  }

  function gunlukYaz(metin) {
    var v = $("video");
    gunluk.unshift(new Date().toTimeString().slice(0, 8) + "  " + metin +
      "  · t=" + Math.round(v.currentTime || 0) + "sn tampon=" + tamponIleri(v).toFixed(1) + "sn rs=" + v.readyState);
    if (gunluk.length > 300) gunluk.length = 300;
    if (!gunlukSayac) gunlukSayac = setTimeout(gunlukGonder, 3000);
  }

  function gunlukGonder() {
    if (gunlukSayac) clearTimeout(gunlukSayac);
    gunlukSayac = 0;
    fetch("/api/v1/client_log", {
      method: "POST", credentials: "same-origin",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ device: cihazAd, lines: gunluk })
    }).catch(function () { /* teşhis kaydı: ağ yoksa oynatma etkilenmez */ });
  }

  // Donma = `waiting` ile `playing` arası. Süre ekrana değil günlüğe; ekranda
  // yalnız "tamponlanıyor" — kumandaya basmadan donmanın nedeni görülsün.
  $("video").addEventListener("waiting", function () {
    if (ekran !== "oynatici" || bekleBas) return;
    bekleBas = Date.now();
    durum("Tamponlanıyor…");
    gunlukYaz("BEKLE");
  });
  // `stalled` tampon doluyken de gelir (indirecek bir şey yok); yalnız oynatma
  // aç kaldığında anlamlı.
  $("video").addEventListener("stalled", function () {
    if (ekran === "oynatici" && $("video").readyState < 3) gunlukYaz("STALLED (ağdan veri gelmiyor)");
  });
  $("video").addEventListener("playing", function () {
    if (!bekleBas) { if ($("durum").textContent.indexOf("dene") >= 0) durum(""); return; }
    var ms = Date.now() - bekleBas;
    bekleBas = 0;
    durum("");
    gunlukYaz("DEVAM " + (ms / 1000).toFixed(1) + "sn bekledi");
  });

  // Hata oynatıcıyı hemen kapatmaz: önce aynı kaynak kaldığı yerden 2 kez (kopan
  // bağlantı, tükenmiş jeton), sonra sıradaki kaynak, en son mesaj. Aynı noktada
  // tekrar tekrar düşmesin diye sayaç ancak 30 sn ilerleyince sıfırlanır.
  $("video").addEventListener("error", function () {
    var v = $("video");
    if (ekran !== "oynatici" || !oynayan) return;
    var konum = v.currentTime || 0;
    gunlukYaz("HATA kod=" + (v.error ? v.error.code : "?") + " " + kaynakHost(v.src));
    bekleBas = 0;
    if (konum > oynayan.tekrarKonum + 30) oynayan.tekrar = 0;
    oynayan.tekrarKonum = konum;
    if (oynayan.tekrar < 2) {
      oynayan.tekrar++;
      durum("Bağlantı koptu, yeniden deneniyor…");
      gunlukYaz("YENİDEN " + oynayan.tekrar + "/2");
      kaynakKur(oynayan.sira, konum);
      return;
    }
    if (oynayan.sira + 1 < oynayan.kaynaklar.length) {
      oynayan.tekrar = 0;
      durum("Sıradaki kaynak deneniyor…");
      gunlukYaz("SIRADAKİ KAYNAK " + (oynayan.sira + 2) + "/" + oynayan.kaynaklar.length);
      kaynakKur(oynayan.sira + 1, konum);
      return;
    }
    durum("Bu kaynak açılamadı");
    setTimeout(function () { durum(""); oynatmaKapat(); }, 3000);
  });

  veriYukle();
})();
</script>
</body>
</html>
