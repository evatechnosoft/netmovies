# NetMovies — stream (UI + proxy + gateway) ortam değişkenleri

# ? Sağlayıcı kimliği (arayüzde görünen ad)
PROVIDER_NAME=NetMovies
PROVIDER_DESCRIPTION=Kişisel, reklamsız izleme arayüzü.

# ? Motor adresi: KekikStream'i çalıştıran engine servisi (docker compose içinde "engine")
DEFAULT_PROVIDER_URL=http://engine:3310

# ? Harici stream proxy KULLANMA — boş bırakılırsa yerleşik /proxy aktif olur (istenen bu)
# PROXY_URL=
# PROXY_FALLBACK_URL=

# ? Eklentiler için giden istek proxy'si (gerekmiyorsa dokunma)
# HTTP_PROXY=
# HTTPS_PROXY=
