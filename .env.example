# NetMovies yapılandırması — kopyala: cp .env.example .env, sonra doldur.
AUTH_USER=dean
AUTH_PASS=degistir-guclu-bir-sifre
# Proxy token imzalama anahtarı (uzun rastgele değer önerilir)
PROXY_TOKEN_SECRET=

# Domainler otomatik keşfedilir (Kekik-cloudstream'den güncel çekilir) — normalde
# BUNLARA DOKUNMANA GEREK YOK. Sadece bir kaynağı elle sabitlemek istersen doldur.
RECTV_URL=
HDFC_URL=
DIZIYOU_URL=
DIZIBOX_URL=
DIZILLA_URL=
DIZIMOM_URL=
# Kendi M3U/M3U8 listen (virgülle ayrılmış; /data/lists altına koy)
M3U_SOURCES=
# Poster fallback için TMDB API anahtarı (ücretsiz: themoviedb.org → Settings → API → API Key v3 auth).
# Boş bırakılırsa kaynak posteri kırıksa placeholder gösterilir.
TMDB_API_KEY=
# 4K segment cache boyutu (MB)
SEGMENT_CACHE_MB=256
# Cloudflare Tunnel token — w.evaitec.com'u eve bağlamak için
CF_TUNNEL_TOKEN=
