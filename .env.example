# NetMovies yapılandırması — kopyala: cp .env.example .env, sonra doldur.
# Tum siteyi Basic Auth ile kilitlemek istersen doldur. BOS birakilirsa izleme
# herkese aciktir (kisisel kullanim / kumandayla giris kolayligi).
AUTH_USER=
AUTH_PASS=
# Yonetim paneli parolasi (/admin ve /api/admin). Izleme acik kalsa bile admin
# bununla kilitlenir. Public tunel kullaniyorsan MUTLAKA doldur.
ADMIN_PASS=degistir-bir-parola
# Proxy token imzalama anahtari — BOS BIRAKMA. Bos ise anahtar her stream
# baslangicinda yeniden uretilir; devam eden izleme "yayin bulunamadi" ile kopar
# (TV'nin elindeki manifest jetonlari gecersiz kalir). Uret:
#   python -c "import secrets; print(secrets.token_hex(32))"
PROXY_TOKEN_SECRET=
# Proxy'nin ulasabilecegi ic ag bloklari (CIDR, virgulle ayrik). Internet zaten
# serbest; bu liste yalniz ozel/LAN adreslerini acar — ornegin NAS/ZimaOS uzerindeki
# M3U listesi ya da LAN'daki IPTV sunucusu. Bos birakirsan ic ag tamamen kapanir.
PROXY_ALLOWED_NETS=192.168.0.0/16

# Domainler otomatik keşfedilir (Kekik-cloudstream'den güncel çekilir) — normalde
# BUNLARA DOKUNMANA GEREK YOK. Sadece bir kaynağı elle sabitlemek istersen doldur.
HDFC_URL=
DIZIYOU_URL=
DIZIBOX_URL=
DIZILLA_URL=
DIZIMOM_URL=
DIZIPAL_URL=
SEZONLUKDIZI_URL=
# Kendi M3U/M3U8 listen (virgülle ayrılmış; /data/lists altına koy). Bos birakilirsa
# Canli TV icin iptv-org'un bakimli TR listesi kullanilir (bkz. docker-compose.yml).
M3U_SOURCES=
# Poster fallback için TMDB API anahtarı (ücretsiz: themoviedb.org → Settings → API → API Key v3 auth).
# Boş bırakılırsa kaynak posteri kırıksa placeholder gösterilir.
TMDB_API_KEY=
# Siteye giris PIN'i — tunelden (w.evaitec.com) acikken sorulan kapi.
# NORMALDE BURAYA YAZMA: Yonetim panelinden gir (Yonetim -> Siteye Giris PIN'i).
# Bu satir yalnizca yedek yol. Bos = kapi yok, adresi bilen herkes girer.
# TV uygulamasi bundan ETKILENMEZ (koruma cerezle, TV cerez tasimaz).
SITE_PIN=

# Sesli kumanda (/rc sayfasindaki mikrofon) icin Google Gemini anahtari.
# NORMALDE BURAYA YAZMA: Yonetim panelinden gir (Yonetim -> Sesli Kumanda).
# Ucretsiz: aistudio.google.com -> Get API key. Bos birakilirsa mikrofon
# tarayicinin kendi konusma tanimasina duser (yalniz arama yapar, komut vermez).
# Anahtar YALNIZ sunucuda durur, istemciye hic gitmez.
GEMINI_API_KEY=
# Model adi degisirse kod degil bu satir guncellenir.
GEMINI_MODEL=gemini-2.5-flash

# 4K segment cache boyutu (MB)
SEGMENT_CACHE_MB=256
# Cloudflare Tunnel token — w.evaitec.com'u eve bağlamak için
CF_TUNNEL_TOKEN=
