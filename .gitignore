# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local
# .env yedekleri de sir tasir (parola/token) — kazara commit edilmesin
.env.bak*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python (stream/ ve engine/)
__pycache__/
*.py[cod]
.venv/
stream/.env
engine/.env

# basla.py'nin ürettiği minify çıktıları
stream/Public/Home/Static/**/*.min.js
stream/Public/Home/Static/**/*.min.css
engine/Public/Home/Static/**/*.min.js
engine/Public/Home/Static/**/*.min.css

# admin runtime config (volume) — yalnız kökteki ./data (compose mount); köke
# sabitli, aksi halde client-tv `.../tv/data/` kaynak paketini de gizliyordu.
/data/
stream/admin.json
engine/admin.json

# SQLite veri (runtime, /data volume) — izleme geçmişi/favoriler
*.db
*.db-journal
*.db-wal

# yerel gizli env (sifreler)
/.env

# Yayin APK'lari GitHub Release'te durur, repoda degil (her biri ~20MB).
NetMovies-TV-*.apk
autostart.log
