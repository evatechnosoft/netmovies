<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- OTA: indirilen APK'yı kurmak için -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- TV + telefon: dokunmatik ve leanback zorunlu değil -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+: konuşma tanıma uygulaması ancak böyle görünür. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/app_banner"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.NetMoviesTV">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout"
            android:theme="@style/Theme.NetMoviesTV">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Telefon launcher + TV leanback launcher -->
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- OTA: indirilen APK'yı FileProvider ile kurulum intent'ine ver -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Widget'taki mikrofon/arama: şeffaf, tek işlik giriş ekranı. -->
        <activity
            android:name=".widget.KumandaGirisActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.NetMoviesTV.Saydam" />

        <!-- Telefonda arama: sonuç listesi + bilgi kartı. Saydam DEĞİL, kendi
             ekranı; geri basınca widget'a dönülür, uygulama açılmaz. -->
        <activity
            android:name=".widget.AramaActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!-- Telefon ana ekranı kumandası: uygulamayı açmadan TV'yi sürer. -->
        <receiver
            android:name=".widget.RemoteWidget"
            android:exported="false"
            android:label="@string/widget_ad">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_remote_info" />
        </receiver>

        <!-- PackageInstaller oturum sonucu: onay ekranını açan alıcı -->
        <receiver
            android:name=".update.InstallReceiver"
            android:exported="false" />
    </application>
</manifest>
