<?xml version="1.0" encoding="utf-8"?>
<!--
  Ana ekran kumandası — saat ekranındaki pad'in telefon hâli.

  Pad'in üst köşeleri boş duruyordu: sola mikrofon, sağa arama (ikisi de ince bir
  giriş ekranı açıp metni /api/v1/voice'a yollar — uygulama açılmaz).

  Yön tuşları ARTI düzeninde: tek sıraya dizilmiş ◀▲OK▼▶ kumanda gibi durmuyordu
  (Dean, 17 Eylül: "o tuşlar ne öyle"). Orta sütun yukarı/OK/aşağı, yanlar sol/sağ;
  alt köşelerde geri ve ana ekran — parmak pad'in üstünde kalır, adım adım gezinir.

  Poster yayı: merkez büyük ve seçili, kenarlar küçülüp solar. RemoteViewsService/
  Factory DEĞİL, beş sabit ImageView — beş görsel için ayrı servis + adaptör
  taşımaya değmez; seçili indeks SharedPreferences'ta durur.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_zemin"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_baslik"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:text="Televizyon" />

    <TextView
        android:id="@+id/widget_alt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#B3FFFFFF"
        android:textSize="11sp"
        android:text="—" />

    <!-- Devam Et yayı: merkez büyük ve seçili, kenarlara doğru küçülür. Kenardaki
         postere dokunmak onu merkeze kaydırır, merkeze dokunmak televizyonda açar. -->
    <LinearLayout
        android:id="@+id/widget_posterler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:baselineAligned="false">

        <ImageView
            android:id="@+id/widget_poster1"
            style="@style/NmWidgetPoster"
            android:layout_weight="0.7"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:alpha="0.45"
            android:contentDescription="@string/widget_poster_aciklama" />

        <ImageView
            android:id="@+id/widget_poster2"
            style="@style/NmWidgetPoster"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:alpha="0.75"
            android:contentDescription="@string/widget_poster_aciklama" />

        <ImageView
            android:id="@+id/widget_poster3"
            style="@style/NmWidgetPoster"
            android:layout_weight="1.5"
            android:contentDescription="@string/widget_poster_aciklama" />

        <ImageView
            android:id="@+id/widget_poster4"
            style="@style/NmWidgetPoster"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:alpha="0.75"
            android:contentDescription="@string/widget_poster_aciklama" />

        <ImageView
            android:id="@+id/widget_poster5"
            style="@style/NmWidgetPoster"
            android:layout_weight="0.7"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:alpha="0.45"
            android:contentDescription="@string/widget_poster_aciklama" />
    </LinearLayout>

    <!-- Yön pad'i: artı. Üç satır, orta sütun ▲ OK ▼. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView android:id="@+id/widget_mikrofon" style="@style/NmWidgetPad" android:text="🎤" />
            <TextView android:id="@+id/widget_yukari" style="@style/NmWidgetPad" android:text="▲" />
            <TextView android:id="@+id/widget_ara" style="@style/NmWidgetPad" android:text="🔍" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView android:id="@+id/widget_sol" style="@style/NmWidgetPad" android:text="◀" />
            <TextView
                android:id="@+id/widget_ok"
                style="@style/NmWidgetPad"
                android:background="@drawable/widget_dugme_vurgu"
                android:text="OK" />
            <TextView android:id="@+id/widget_sag" style="@style/NmWidgetPad" android:text="▶" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView android:id="@+id/widget_geri_tus" style="@style/NmWidgetPad" android:text="↩" />
            <TextView android:id="@+id/widget_asagi" style="@style/NmWidgetPad" android:text="▼" />
            <TextView android:id="@+id/widget_ev" style="@style/NmWidgetPad" android:text="⌂" />
        </LinearLayout>
    </LinearLayout>

    <!-- Sarma / duraklatma. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <TextView android:id="@+id/widget_geri" style="@style/NmWidgetDugme" android:text="−30" />
        <TextView
            android:id="@+id/widget_oynat"
            style="@style/NmWidgetDugme"
            android:background="@drawable/widget_dugme_vurgu"
            android:text="▶" />
        <TextView android:id="@+id/widget_ileri" style="@style/NmWidgetDugme" android:text="+30" />
    </LinearLayout>
</LinearLayout>
