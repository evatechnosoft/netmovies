<?xml version="1.0" encoding="utf-8"?>
<!--
  4x3 varsayılan: poster şeridi + yön pad'i + sarma satırı ancak bu boya sığıyor.
  resizeMode açık — küçültülünce alt satırlar kırpılır, büyütülünce posterler
  büyür. updatePeriodMillis sistemin en sık izin verdiği değer (30 dk); dakikalık
  tazeleme AlarmManager ile, widget varken kuruluyor.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/widget_remote"
    android:previewLayout="@layout/widget_remote"
    android:description="@string/widget_aciklama"
    android:updatePeriodMillis="1800000" />
