<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Saat ev Wi-Fi'sindeki sunucuya doğrudan bağlanır; telefon aracı değil. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- requestNetwork(TRANSPORT_WIFI): Wear OS pil icin Wi-Fi radyosunu kapatiyor,
         ev sunucusu LAN'da oldugu icin Bluetooth vekili ise yaramiyor. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Saat kendi kendini gunceller: evaitecOTA bileklikte APK kuramiyordu,
         kurulu uygulama PackageInstaller ile araciya gerek duymadan kurar. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Sesli arama saatin kendi tanıyıcısıyla yapılır. Android 11+ paket
         görünürlüğü yüzünden bu bildirilmezse RecognizerIntent'i çözecek
         uygulama "yok" görünür ve arama sessizce açılmaz. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Ev sunucusu düz HTTP (LAN): saatte de cleartext gerekli. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- PackageInstaller oturum sonucu: onay ekranini acan alici -->
        <receiver
            android:name=".KurulumAlicisi"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
